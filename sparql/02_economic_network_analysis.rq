# Query 2: Economic Network Analysis
# Trace the economic network around a business: employees, tax filings,
# port shipments, and business details.
# Input: Business Registry Number, e.g. "BIZ-001102"
#
# Join mechanism: the business number value (e.g. "BIZ-001102") is carried by
# differently-named components across domains (Business Registry
# organization_identifier, Maritime Business Registry Number, Tax Source Record
# ID). Matching the shared VALUE under ANY component surfaces the full network:
# Business Registry, Maritime, and Tax records. Shows all records containing it.

PREFIX sdc4: <https://semanticdatacharter.com/ns/sdc4/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc:   <http://purl.org/dc/elements/1.1/>

SELECT ?domain ?component_label ?value
WHERE {
  # Find instances containing this business number value under ANY component
  ?brn_reifier rdf:reifies <<?mcBrn ?vpBrn "BIZ-001102">> ;
               sdc4:inInstance ?instance ;
               sdc4:inDataModel ?dm .

  OPTIONAL { ?dm dc:title ?dm_title }
  BIND(COALESCE(?dm_title, REPLACE(STR(?dm), '.*/dm-', '')) AS ?domain)

  # Get all components from the same instance
  ?comp_reifier sdc4:inInstance ?instance ;
                rdfs:label ?component_label ;
                rdf:reifies <<?mcC ?vpC ?value>> .
}
ORDER BY ?domain ?component_label
LIMIT 500

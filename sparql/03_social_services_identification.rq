# Query 3: Social Services Identification
# Find people with healthcare records in a specific city.
# Cross-references Civil Registry (for name/city) with Healthcare (for diagnosis).
# Input: City name, e.g. "Porto Sereno"
#
# Join mechanism: National ID (CID) shared component links Civil Registry
# and Healthcare records for the same person.

PREFIX sdc4: <https://semanticdatacharter.com/ns/sdc4/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?given_name ?surname ?cid_value ?diagnosis ?facility ?inst ?inst_2
WHERE {
  # Find people in Porto Sereno via Civil Registry
  ?city_reifier rdf:reifies <<sdc4:mc-atdtdfzruh7tya0iv5cz365l ?vpCity "Porto Sereno">> ;
                sdc4:inInstance ?civil_inst ;
                sdc4:inDataModel sdc4:dm-etkbxubkngv0v81yvqz77xrs .

  # Get their CID from the same civil registry instance
  ?cid_reifier rdf:reifies <<sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 ?vpCid ?cid_value>> ;
               sdc4:inInstance ?civil_inst .

  # Get their name
  ?given_reifier rdf:reifies <<sdc4:mc-l9l169co9r23e6fftpvdz4e3 ?vpGiven ?given_name>> ;
                 sdc4:inInstance ?civil_inst .
  ?surname_reifier rdf:reifies <<sdc4:mc-jc1lfk3ovt6l8frhxvx8b669 ?vpSurname ?surname>> ;
                   sdc4:inInstance ?civil_inst .

  # Cross-domain join: find healthcare records with the same CID
  ?hc_cid_reifier rdf:reifies <<sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 ?vpHcCid ?cid_value>> ;
                  sdc4:inInstance ?hc_inst ;
                  sdc4:inDataModel sdc4:dm-dcsd8bxr8a6lzcptwwyms44t .

  # Get diagnosis from healthcare instance
  ?diag_reifier rdf:reifies <<sdc4:mc-efimv7gxg5ompt8m6xb2b6k5 ?vpDiag ?diagnosis>> ;
                sdc4:inInstance ?hc_inst .

  # Get facility
  OPTIONAL {
    ?fac_reifier sdc4:inInstance ?hc_inst ;
                 rdfs:label "Managing Organization Reference" ;
                 rdf:reifies <<sdc4:mc-k1ahxtkgbqehv11vx9aw2fzz ?vpFac ?facility>> .
  }
  BIND(?hc_inst AS ?inst)
  BIND(?civil_inst AS ?inst_2)
}
ORDER BY ?surname ?given_name
LIMIT 200

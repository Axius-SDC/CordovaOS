# Query 6: Institutional Impact
# For an institution (via BRN), find all records in the Business Registry,
# then find students at the institution via Education records sharing
# the same city/province.
# Input: Institution BRN, e.g. "BIZ-000847" (Universidad Nacional de Cordova)
#
# Join mechanism: the business number value matches the Business Registry
# organization_identifier component; Education records in the same city show
# the institutional footprint.

PREFIX sdc4: <https://semanticdatacharter.com/ns/sdc4/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc:   <http://purl.org/dc/elements/1.1/>
SELECT ?category ?detail_label ?detail_value ?inst ?inst_2
WHERE {
  {
    ?brn_reifier rdf:reifies <<sdc4:mc-ule5u2z3rjpa9pooaifwj1n3 ?vpBrn "BIZ-000847">> ;
                 sdc4:inInstance ?biz_inst ;
                 sdc4:inDataModel sdc4:dm-x250838l7oi6l3yavg9twc1i .
    ?comp_reifier sdc4:inInstance ?biz_inst ;
                  rdfs:label ?detail_label ;
                  rdf:reifies <<?mcComp ?vpComp ?detail_value>> .
    BIND("Business Registry" AS ?category)
    BIND(?biz_inst AS ?inst)
  }
  UNION
  {
    # The city the business is registered from, computed once in a subquery so
    # the BIND is not a barrier in front of the education join.
    {
      SELECT ?biz_inst2 (REPLACE(STR(?loc_name), " Data Center", "") AS ?inst_city) WHERE {
        ?brn_reifier2 rdf:reifies <<sdc4:mc-ule5u2z3rjpa9pooaifwj1n3 ?vpBrn2 "BIZ-000847">> ;
                      sdc4:inInstance ?biz_inst2 ;
                      sdc4:inDataModel sdc4:dm-x250838l7oi6l3yavg9twc1i .
        ?biz_loc_reifier sdc4:inInstance ?biz_inst2 ;
                         rdfs:label "system_location_name" ;
                         rdf:reifies <<?mcBizLoc ?vpBizLoc ?loc_name>> .
      }
    }
    ?edu_city_reifier rdf:reifies <<sdc4:mc-atdtdfzruh7tya0iv5cz365l ?vpEduCity ?inst_city>> ;
                      sdc4:inInstance ?edu_inst ;
                      sdc4:inDataModel sdc4:dm-upq7w1bqbix5v5ss0mu3kq5n .
    ?edu_comp sdc4:inInstance ?edu_inst ;
              rdfs:label ?detail_label ;
              rdf:reifies <<?mcEdu ?vpEdu ?detail_value>> .
    FILTER(?detail_label IN ("National ID (CID)", "Student ID", "Field of Study",
                              "Enrollment Status", "Institution Name"))
    BIND("Education Record" AS ?category)
    BIND(?edu_inst AS ?inst)
    BIND(?biz_inst2 AS ?inst_2)
  }
}
ORDER BY ?category ?detail_label
LIMIT 500

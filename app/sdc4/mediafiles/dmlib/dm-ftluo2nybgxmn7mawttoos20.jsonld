  "components": [
    {
      "@type": "ClusterType",
      "@id": "sdc4:mc-w0lu0us3nbxaedfum9i8itpc",
      "label": "Healthcare Governed Record",
      "description": "Root data cluster (DMType Item) for a governed healthcare record in CordovaOS: an individual's clinical and health information. Wraps the domain's data components with the shared W3C PROV-O Provenance cluster so each record carries its lineage bound alongside its data. Workflow, attestation, parties, and the system audit trail sit in the DMType's native governance slots; access control and retention apply as bound sdcgovernance policy.",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "contains": [],
      "semanticLinks": [
        {
          "predicate": "skos:closeMatch",
          "object": "https://www.wikidata.org/wiki/Q95459148"
        }
      ]
    }
  ],
  "structural_components": {
    "subject": {
      "@type": "PartyType",
      "@id": "sdc4:mc-bc1ivx4vqa5gh3p5l1pjs1q2",
      "label": "Primary Care Assignment",
      "description": "Patient's assigned primary care provider (clinician) and primary care facility. W3C PROV-DM Agent supporting Person and Organization.",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "dataType": "xsd:string",
      "semanticLinks": [

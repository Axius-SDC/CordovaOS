    {
      "@type": "XdTokenType",
      "@id": "sdc4:mc-kv5qqs3o4jwcwz9javgw1pzh",
      "label": "Province",
      "description": "One of the three provinces of the Republic of Cordova. Used across civil registry, property, tax, and all geographic records.",

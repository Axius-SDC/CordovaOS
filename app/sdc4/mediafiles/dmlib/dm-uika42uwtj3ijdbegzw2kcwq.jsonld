      "@type": "XdStringType",
      "@id": "sdc4:mc-kfyzf8u8gdafcpt5kfh2qg3q",
      "label": "Given Name (Person)",
      "description": "name typically used to differentiate people from the same family, clan, or other social group who have a common last name\naka. first name or forename",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "constraints": {
        "minLength": 1,
        "maxLength": 100
      },
      "dataType": "xsd:string",

    {
      "@type": "XdTokenType",
      "@id": "sdc4:mc-mw9qdn71urog8egjbp5t3y00",
      "label": "Sex",
      "description": "Biological sex assigned at birth based on physical characteristics. UMLS CUI: C0079399 (Biologic Sex). Aligned with OMB standards for reporting.",

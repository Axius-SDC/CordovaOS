      "@id": "sdc4:mc-cymq16em5zb20whgtfzki6n5",
      "label": "Gender Identity",
      "description": "Self-reported gender identity of the participant",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1

  "components": [
    {
      "@type": "ClusterType",
      "@id": "sdc4:mc-aan7382wp8e2f58m9a2hvmkp",
      "label": "Civil Registry Governed Record",
      "description": "Root data cluster (DMType Item) for a governed civil-registry record in CordovaOS: a person's civil-status events such as births, marriages, and deaths. Wraps the domain's data components with the shared W3C PROV-O Provenance cluster so each record carries its lineage bound alongside its data. Workflow, attestation, parties, and the system audit trail sit in the DMType's native governance slots; access control and retention apply as bound sdcgovernance policy.",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "contains": []
    }
  ],
  "structural_components": {
    "subject": {
      "@type": "PartyType",
      "@id": "sdc4:mc-avqpyqft9tm22yyink3ltcty",
      "label": "Related Person",
      "description": "Person related to the civil registry subject via family relationship (parent, child, spouse, etc.). W3C PROV-DM Agent (Person) with Cordova CID.",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "dataType": "xsd:string",
      "semanticLinks": [

    {
      "@type": "XdTemporalType",
      "@id": "sdc4:mc-g3k6bj8su3rvkszg2700dhyh",
      "label": "Birth Date",
      "description": "Date of birth of the participant. UMLS CUI: C0421451 (Date of birth). LOINC: 21112-8 (Birth date).",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "dataType": "xsd:dateTime",
      "semanticLinks": [
        {
          "predicate": "http://www.w3.org/2000/01/rdf-schema#isDefinedBy",
          "object": "https://www.wikidata.org/wiki/Q2389905"
        }
      ]
    },
    {
      "@type": "XdStringType",
      "@id": "sdc4:mc-x0na649n17if0ukul82cmrx3",
      "label": "Cordova Email Address",
      "description": "Email address using one of the Cordova national email providers. Providers: cordomail.co, novamail.co, portocorreo.co",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "constraints": {
        "pattern": "[-a-zA-Z0-9._%+]+@(cordomail|novamail|portocorreo)\\.co"
      },
      "dataType": "xsd:string",
      "semanticLinks": [
        {
          "predicate": "http://www.w3.org/2000/01/rdf-schema#isDefinedBy",
          "object": "https://www.wikidata.org/wiki/Q1273217"
        },
        {
          "predicate": "http://www.w3.org/2004/02/skos/core#broadMatch",
          "object": "https://schema.org/name"
        }
      ]
    },
    {
      "@type": "XdStringType",
      "@id": "sdc4:mc-nfrvvp87c5imu5h9ups92kgy",
      "label": "Cordova Phone Number",
      "description": "Cordova national telephone number. Format: +99-PPP-NNN-NNNN where +99 is the country code and PPP is the area code. Area codes: Porto Sereno=100, Vistamar=110, Rioseco=120, Campoluz=200, Tierraverde=210, Montecara=220, Novaciudad=300, Piedrasol=310, Lagunavista=320.",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "constraints": {
        "pattern": "\\+99-[123][012]0-[0-9]{3}-[0-9]{4}"
      },
      "dataType": "xsd:string",
      "semanticLinks": [
        {
          "predicate": "http://www.w3.org/2000/01/rdf-schema#isDefinedBy",
          "object": "https://www.wikidata.org/wiki/Q214995"
        },
        {
          "predicate": "http://www.w3.org/2004/02/skos/core#relatedMatch",
          "object": "https://www.wikidata.org/wiki/Q214995"
        }
      ]

    rdfs:label "Tax Record Access Control" ;
    rdfs:comment "Access control policy for tax records using W3C Data Privacy Vocabulary. Enforces role-based access for tax authority officials, taxpayers, and authorized accountants. Governs dpv:FinancialData including tax returns, assessments, and payment records." ;
    rdfs:isDefinedBy <https://w3id.org/dpv#AccessControlMethod>,
        <https://www.wikidata.org/wiki/Q2861384> ;

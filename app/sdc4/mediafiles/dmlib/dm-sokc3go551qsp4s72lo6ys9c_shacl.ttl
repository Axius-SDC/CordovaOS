            sh:path sdc4-meta:hasUnit ],
        [ sh:hasValue sdc4:mc-ecyu6tt7kkjq4rzhthe74ed6 ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue schema:longitude ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 180.00000 ;
            sh:minCount 1 ;
            sh:minInclusive -180.00000 ;
            sh:path sdc4:xdquantity-value ],
        [ sh:hasValue <http://qudt.org/> ;
            sh:path dcterms:source ],
        [ sh:hasValue sdc4:mc-su36p04drmw1szee9cw51mgw ;
            sh:path sdc4-meta:hasUnit ],
        [ sh:hasValue <http://purl.obolibrary.org/obo/NCIT_C68643> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-qh625ukiiju3ak4x45tehcnr ;
    sdc4-meta:sdcType "XdQuantityType" .


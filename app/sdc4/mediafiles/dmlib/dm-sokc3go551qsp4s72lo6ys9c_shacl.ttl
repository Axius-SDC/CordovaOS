sdc4:mc-bzj79tikzsv5s4qu83f7qx3m-shape a sh:NodeShape ;
    rdfs:label "Vital Statistics Protocol" ;
    rdfs:comment "Protocol reference for the Vital Statistics Record data model. Informed by the United Nations Principles and Recommendations for a Vital Statistics System (Revision 3), WHO International Form of Medical Certificate of Cause of Death, and regional vital statistics reporting standards." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q69484> ;
            sh:path skos:relatedMatch ],
        [ sh:datatype xsd:string ;

            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q317623> ;
            sh:path skos:broadMatch ] ;
    sh:targetNode sdc4:mc-bzj79tikzsv5s4qu83f7qx3m ;
    sdc4-meta:sdcType "XdStringType" .


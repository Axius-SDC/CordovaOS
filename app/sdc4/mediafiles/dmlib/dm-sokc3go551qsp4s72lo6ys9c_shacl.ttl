sdc4:mc-e5y0pxyzufjfq3rvcdq9jh86-shape a sh:NodeShape ;
    rdfs:label "Document Publishing: Main path states" ;
    rdfs:comment "States of the Main path path of the Document Publishing workflow, in order: draft, submitted, under-review, accepted-for-publication, proof, published, version-of-record, archived. A transition is legal between adjacent states. The publishing lifecycle of a document from the SPAR Publishing Status Ontology: draft, submission, review, acceptance or rejection, proof, publication, version of record, archive, with withdrawal, revision, embargo and retraction." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue <http://purl.org/spar/pso> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://purl.org/spar/pso/Status> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:string ;
            sh:in ( "draft" "submitted" "under-review" "accepted-for-publication" "proof" "published" "version-of-record" "archived" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" "2" "3" "4" "5" "6" "7" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/document-publishing-main-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue sdc4:mc-p63gkbxxov51unemwc71ay44 ;
            sh:path prov:wasRevisionOf ] ;
    sh:targetNode sdc4:mc-e5y0pxyzufjfq3rvcdq9jh86 ;
    sdc4-meta:sdcType "XdOrdinalType" .

sdc4:mc-efimv7gxg5ompt8m6xb2b6k5-shape a sh:NodeShape ;
    rdfs:label "Diagnosis Code (ICD-10-CM)" ;
    rdfs:comment "The ICD-10-CM code for the condition, problem or diagnosis. FHIR Condition.code, coded in http://hl7.org/fhir/sid/icd-10-cm." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <http://hl7.org/fhir/sid/icd-10-cm> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://hl7.org/fhir/sid/icd-10-cm> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://hl7.org/fhir/R4/condition-definitions.html#Condition.code> ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "[A-TV-Z][0-9][0-9AB](\\.[0-9A-TV-Z]{1,4})?" ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/diagnosis-icd10cm-code> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue sdc4:mc-gnssdkny454dgbykbs16wuew ;
            sh:path prov:wasRevisionOf ] ;
    sh:targetNode sdc4:mc-efimv7gxg5ompt8m6xb2b6k5 ;
    sdc4-meta:sdcType "XdStringType" .


sdc4:mc-s4ojal8u24bpqes3azcqv1b3-shape a sh:NodeShape ;
    rdfs:label "Document Publishing: under review rejected for publication states" ;
    rdfs:comment "States of the under review rejected for publication path of the Document Publishing workflow, in order: under-review, rejected-for-publication. A transition is legal between adjacent states. The publishing lifecycle of a document from the SPAR Publishing Status Ontology: draft, submission, review, acceptance or rejection, proof, publication, version of record, archive, with withdrawal, revision, embargo and retraction." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "under-review" "rejected-for-publication" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <http://purl.org/spar/pso/Status> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://purl.org/spar/pso> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/document-publishing-under-review-rejected-for-publication-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-s4ojal8u24bpqes3azcqv1b3 ;
    sdc4-meta:sdcType "XdOrdinalType" .


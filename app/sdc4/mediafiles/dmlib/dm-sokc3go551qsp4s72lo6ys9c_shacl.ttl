sdc4:mc-rqeuaeoe81e9siuma9cu7zz1-shape a sh:NodeShape ;
    rdfs:label "Vital Statistics Access Control" ;
    rdfs:comment "Access control policy for vital statistics data using W3C Data Privacy Vocabulary. Enforces role-based access for vital statistics officials, citizens, and authorized representatives. Governs dpv:SpecialCategoryPersonalData including birth certificates, death certificates, and demographic records." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ],
        [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <https://w3id.org/dpv#SpecialCategoryPersonalData> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q18562479> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ] ;
    sh:targetNode sdc4:mc-rqeuaeoe81e9siuma9cu7zz1 ;
    sdc4-meta:sdcType "XdLinkType" .


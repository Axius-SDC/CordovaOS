    rdfs:label "Condition Verification Status" ;
    rdfs:comment "The verification status of the condition. FHIR Condition.verificationStatus; ConditionVerificationStatus, version 4.0.1." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .


<> dc:coverage "Universal" ;
    dc:creator "Timothy Cook" ;
    dc:date "2026-09-26 15:05:35.253999+00:00" ;
    dc:description "Maintain basic medical records for all persons in Cordova." ;
    dc:format "text/xml" ;
    dc:identifier "dm-dcsd8bxr8a6lzcptwwyms44t" ;
    dc:language "en-US" ;
    dc:publisher "Axius SDC, Inc." ;
    dc:relation "None" ;
    dc:rights "CC-BY http://creativecommons.org/licenses/by/3.0/" ;
    dc:subject "Healthcare Record" ;
    dc:title "Healthcare Record 4.4.0" ;
    dc:type "SDC Data Model (DM)" .

sdc4:mc-5scaiw897xhuqa1k8sso932e a sdc4-meta:ModelComponent ;
    rdfs:label "Healthcare Provider" ;
    rdfs:isDefinedBy prov:Agent,
        <https://hl7.org/fhir/> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-a5scyosu6j84vz350mqyrzl2 a sdc4-meta:ModelComponent ;
    rdfs:label "Ended At" ;
    rdfs:comment "When the activity ended (prov:endedAtTime)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-aa663ivutjf2fs4757t0bbzy a sdc4-meta:ModelComponent ;
    rdfs:label "Software Name" ;
    rdfs:comment "The name of a software agent." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-acqzuzmvr5bsrksbhjm9mk38 a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: Main path" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-afwwbc4y85tqzl9zdxxy7m9t a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: arrived cancelled" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-anbcg4rhacgmv8lkfofymmv0 a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter Start" ;
    rdfs:comment "When the encounter started. FHIR Encounter.period.start." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-atmov6klp3a57hmokoxlx77t a sdc4-meta:ModelComponent ;
    rdfs:label "Language Preferred" ;
    rdfs:comment "Whether the language is the patient's preferred one. FHIR Patient.communication.preferred." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-atvd5lzut4pjzc7dpv1ykb92 a sdc4-meta:ModelComponent ;
    rdfs:label "Vital Signs Panel" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-aw1hrptamag4xuobxj5hg54i a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: Main path states" ;
    rdfs:comment "States of the Main path path of the Encounter workflow, in order: planned, arrived, triaged, in-progress, finished. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-bifhmqewvflp8bgduuvte8w7 a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: onleave in progress" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-c179ilk2ns15cd5rzzdfd6f6 a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Agent" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-c2ezzwg0q7fwuarfn7aiouyt a sdc4-meta:ModelComponent ;
    rdfs:label "Administration Route (SNOMED CT)" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-c5e0wv21cmlouukx6ga2o5uz a sdc4-meta:ModelComponent ;
    rdfs:label "Latitude" ;
    rdfs:comment "Geographic latitude in decimal degrees, -90 to +90." ;
    sdc4-meta:hasUnit sdc4:mc-su36p04drmw1szee9cw51mgw ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-cdt3eno621fle59qg7k0ojr4 a sdc4-meta:ModelComponent ;
    rdfs:label "Onset Date" ;
    rdfs:comment "When the condition began. FHIR Condition.onsetDateTime." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-cedt8wdrsq2im0osa5kc4m6d a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: planned cancelled" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-cmtzyf0esp2hbf8ze2q0d3bh a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter Reason Code (SNOMED CT)" ;
    rdfs:comment "The SNOMED CT code for the reason the encounter takes place. FHIR Encounter.reasonCode, coded in http://snomed.info/sct." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-cuxxvwyqn5vhlqjymovegmn7 a sdc4-meta:ModelComponent ;
    rdfs:label "Provider Name" ;
    rdfs:comment "Name of the attending physician or provider" ;
    rdfs:isDefinedBy <http://schema.org/name> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-d2xwhnb2vqzxw70jcizj9csx a sdc4-meta:ModelComponent ;
    rdfs:label "Contact Point" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-dchiej5tv7tyhfwr6h3ync1i a sdc4-meta:ModelComponent ;
    rdfs:label "Body Mass Index" ;
    rdfs:comment "Body mass index (LOINC 39156-5) in kg/m2. FHIR Observation.valueQuantity." ;
    sdc4-meta:hasUnit sdc4:mc-ux7molkiumql3ml1pyc0kf2s ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-dcsd8bxr8a6lzcptwwyms44t a schema:Dataset,
        sdc4-meta:ModelComponent ;
    rdfs:label "Healthcare Record 4.4.0" ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q31207> ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Q1132455> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#DMType> .

sdc4:mc-dkc2ccj5te35z9gd4bu1blcq a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Agent Reference" ;
    rdfs:comment "The acting agent (FHIR AuditEvent.agent.who). Holds the IRI of the referenced thing." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-dkyyj01tksb7h7akq2w7moum a sdc4-meta:ModelComponent ;
    rdfs:label "Observation Date Time" ;
    rdfs:comment "The clinically relevant time of the observation. FHIR Observation.effectiveDateTime." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-dleacf69t8nyhv6qf3qel6vq a sdc4-meta:ModelComponent ;
    rdfs:label "Medication Route Code (SNOMED CT)" ;
    rdfs:comment "The SNOMED CT code for the route of administration. FHIR MedicationRequest.dosageInstruction.route, coded in http://snomed.info/sct." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-dnxnysrxf7fa59c52bi6cowy a sdc4-meta:ModelComponent ;
    rdfs:label "Exposure Route (SNOMED CT)" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-doxdajuj6j1mk480zd1k7ssz a sdc4-meta:ModelComponent ;
    rdfs:label "Body Weight" ;
    rdfs:comment "Body Weight (LOINC 29463-7), in the Default units by slot. FHIR Observation.valueQuantity." ;
    sdc4-meta:hasUnit sdc4:mc-n7s7hcgef4pxius8a0l6r5qp ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-e3woxx4x57tjhzyu5ck4bvr7 a sdc4-meta:ModelComponent ;
    rdfs:label "Cordova System User" ;
    rdfs:comment "The user or service account of the Cordova government system that handled the record (PROV agent)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#PartyType> .

sdc4:mc-e8zpir2mt00pvdwmkh0cfd99 a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: arrived cancelled states" ;
    rdfs:comment "States of the arrived cancelled path of the Encounter workflow, in order: arrived, cancelled. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-efimv7gxg5ompt8m6xb2b6k5 a sdc4-meta:ModelComponent ;
    rdfs:label "Diagnosis Code (ICD-10-CM)" ;
    rdfs:comment "The ICD-10-CM code for the condition, problem or diagnosis. FHIR Condition.code, coded in http://hl7.org/fhir/sid/icd-10-cm." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-eftvwi5byq6cdtd931qyxzw0 a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Organization Name" ;
    rdfs:comment "The organization the agent belongs to or is." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-emov6wuhen2tuyjlppqmmjjl a sdc4-meta:ModelComponent ;
    rdfs:label "Healthcare Records Protocol" ;
    rdfs:comment "Protocol reference for the Healthcare Record data model. Informed by the WHO International Classification of Diseases (ICD-11), HL7 FHIR resource concepts for clinical data exchange, and national health information management standards for patient records." ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q132364> ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Q35869> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-eo5tlfr0576ypknys5alvcn0 a sdc4-meta:ModelComponent ;
    rdfs:label "Code Display Text" ;
    rdfs:comment "The human-readable display of a coded value, as recorded with the code (FHIR Coding.display)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-eug2vehpd5ubys6l8x0ebo6y a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: finished entered in error states" ;
    rdfs:comment "States of the finished entered in error path of the Encounter workflow, in order: finished, entered-in-error. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-evzi9namajsr73zvfmu6yk5n a sdc4-meta:ModelComponent ;
    rdfs:label "Dose Quantity Administered" ;
    rdfs:comment "The amount of vaccine administered. FHIR Immunization.doseQuantity." ;
    sdc4-meta:hasUnit sdc4:mc-bp6yoi4abvixdocahrs34xid ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-ezb3mjzu7ya2vsrfkt00t8mu a sdc4-meta:ModelComponent ;
    rdfs:label "General Practitioner Reference" ;
    rdfs:comment "The patient's nominated primary care provider. Holds the IRI of the referenced resource. FHIR Patient.generalPractitioner." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ffh1o5rta29osqbm0jg7a1l7 a sdc4-meta:ModelComponent ;
    rdfs:label "Healthcare Governed Record" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-fjhgr5fyqxt2crmg2cb5c513 a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Event Identifier" ;
    rdfs:comment "The identifier of the audit event." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-fnr5q1tfq42ez9jia9dqueho a sdc4-meta:ModelComponent ;
    rdfs:label "Deceased Indicator" ;
    rdfs:comment "Whether the patient is deceased. FHIR Patient.deceasedBoolean." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-fnxiiamw1uk1hvsxmjgsu1xy a sdc4-meta:ModelComponent ;
    rdfs:label "Hospitalization" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-fo7mfnovqd9ef2yzcfax2fqe a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: onleave in progress states" ;
    rdfs:comment "States of the onleave in progress path of the Encounter workflow, in order: onleave, in-progress. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-fv8e2asumlgp9l4o9p3i2jsf a sdc4-meta:ModelComponent ;
    rdfs:label "Diagnosis (SNOMED CT)" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-g7dmkv2mq6b6j9i6wjzgp9px a sdc4-meta:ModelComponent ;
    rdfs:label "Dispense Quantity" ;
    rdfs:comment "The number of units to dispense. FHIR MedicationRequest.dispenseRequest.quantity." ;
    sdc4-meta:hasUnit sdc4:mc-c3ycqqk7ns1bvmsc0ricnsbn ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdCountType> .

sdc4:mc-gb78cmuyo72hqs5apymdki7l a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Description" ;
    rdfs:comment "A description of the agent and its responsibilities." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-gcjyjrnp0wsfoelcp4m05c67 a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Entity Reference" ;
    rdfs:comment "The entity the event concerns (FHIR AuditEvent.entity.what). Holds the IRI of the referenced thing." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-gdcfl9ghwkswdbmxww4senbt a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter Length" ;
    rdfs:comment "How long the encounter lasted, in the Default time units. FHIR Encounter.length." ;
    sdc4-meta:hasUnit sdc4:mc-pcnnug0ctyr0nhjjj5cn49mi ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-gf841eedvv6cjiegs934srai a sdc4-meta:ModelComponent ;
    rdfs:label "Postal Code" ;
    rdfs:comment "The postal code of an address in any country, with no format constraint. Use US ZIP Code or Canada Postal Code where the format is known." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ginfqbk7q59ld2r4us8sjnv1 a sdc4-meta:ModelComponent ;
    rdfs:label "Was Started By Reference" ;
    rdfs:comment "The entity that started the activity (prov:wasStartedBy). Holds the IRI of the referenced thing." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-gug5dhtqfv7exbgmm2raxpkq a sdc4-meta:ModelComponent ;
    rdfs:label "Digital Signature Proof" ;
    rdfs:comment "Cryptographic proof of attestation (digital signature)" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-data-model/#credentials>,
        <https://www.wikidata.org/wiki/Q210824> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdFileType> .

sdc4:mc-gus7i559nu8qnrmy86tn9ih3 a sdc4-meta:ModelComponent ;
    rdfs:label "Condition" ;

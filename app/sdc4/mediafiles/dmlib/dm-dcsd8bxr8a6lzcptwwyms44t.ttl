sdc4:mc-xxe21o9ojzmy9wxxky1tnmog a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Name" ;
    rdfs:comment "The name of the agent (foaf:name)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-y16hwsqc3wjfn8pc16gnbdvv a sdc4-meta:ModelComponent ;

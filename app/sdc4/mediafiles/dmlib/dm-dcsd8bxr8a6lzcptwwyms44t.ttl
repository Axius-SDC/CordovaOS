    rdfs:label "Healthcare Record Access Control" ;
    rdfs:comment "Access control policy for healthcare data using W3C Data Privacy Vocabulary. Enforces role-based access for healthcare providers, patients, and authorized representatives. Governs dpv:SpecialCategoryPersonalData including medical records, diagnoses, and treatment plans." ;
    rdfs:isDefinedBy <https://w3id.org/dpv#AccessControlMethod>,
        <https://www.wikidata.org/wiki/Q1324077> ;

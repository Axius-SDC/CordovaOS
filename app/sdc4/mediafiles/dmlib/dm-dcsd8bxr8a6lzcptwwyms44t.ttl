sdc4:mc-x1g2wcwrow5f25epkmfbx6vo a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: in progress onleave states" ;
    rdfs:comment "States of the in progress onleave path of the Encounter workflow, in order: in-progress, onleave. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-x22uejq2k3nymbeinuguy90i a sdc4-meta:ModelComponent ;
    rdfs:label "Encounter: in progress onleave" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-xcyx87fkkzxam65vglkbd384 a sdc4-meta:ModelComponent ;
    rdfs:label "Cordova System Audit" ;
    rdfs:comment "The audit of a Cordova government record: the system that handled it, the system user, and where (Default geolocation, Cordova city and province). Replaces the June ProvGov System Audit in every Cordova model." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#AuditType> .

sdc4:mc-xlgjqdpwdbn2re3mdh5yy2rk a sdc4-meta:ModelComponent ;
    rdfs:label "Error Message" ;

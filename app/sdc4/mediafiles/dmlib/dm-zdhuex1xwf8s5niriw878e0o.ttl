sdc4:mc-jwfl94g8mj8aevupivyfsnwj a sdc4-meta:ModelComponent ;
    rdfs:label "Geolocation" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-jx13ihzux8cd382oenzlkn05 a sdc4-meta:ModelComponent ;
    rdfs:label "Address Private Mailbox" ;
    rdfs:comment "A private mailbox within a company. NIEM 6.0 nc:AddressPrivateMailboxText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-k004xjvdu15bhtglwnocmzbr a sdc4-meta:ModelComponent ;
    rdfs:label "Item Status" ;
    rdfs:comment "A status of an item. NIEM 6.0 nc:ItemStatus. The status as text (nc:StatusText)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-k5gokizy3d4m7i8tkzcaoh1m a sdc4-meta:ModelComponent ;
    rdfs:label "Item Brand Name" ;
    rdfs:comment "A distinctive name that identifies a manufacturer of a property item. NIEM 6.0 nc:ItemBrandName." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-kh5yg8z64f4z2lm4cskxmyxt a sdc4-meta:ModelComponent ;
    rdfs:label "Incident Minor Involved Indicator" ;
    rdfs:comment "True if an incident involved or employed a person under the legal age of an adult; false otherwise. NIEM 6.0 j:IncidentMinorInvolvedIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-kjw5o7nn1c9nywmpp93b26ai a sdc4-meta:ModelComponent ;
    rdfs:label "Release From Location Reference" ;
    rdfs:comment "A location from which someone or something is released. NIEM 6.0 nc:ReleaseFromLocation. Holds the IRI of the referenced Location record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-klefs5yh13dopt31i9ysfzis a sdc4-meta:ModelComponent ;
    rdfs:label "Act Lifecycle Workflow" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-klh8unsq1foyx0cnqz9m510r a sdc4-meta:ModelComponent ;
    rdfs:label "Service Call Clearance" ;
    rdfs:comment "A description that identifies the incident conditions or status when a response unit cleared or left the scene designated by a call for service. NIEM 6.0 j:ServiceCallClearanceText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-km66mn841zdvpdpdib8p4ryj a sdc4-meta:ModelComponent ;
    rdfs:label "Statute Keyword" ;
    rdfs:comment "A brief description of a Statute which makes use of catchwords. NIEM 6.0 j:StatuteKeywordText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-kr8fmao4yji8vr46kiw150me a sdc4-meta:ModelComponent ;
    rdfs:label "Code Display Text" ;
    rdfs:comment "The human-readable display of a coded value, as recorded with the code: the preferred label of the code (SKOS prefLabel). In NIEM the equivalent is the *Text substitution beside a *Code." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ktjljh5fuybfhytqkpnks4wn a sdc4-meta:ModelComponent ;
    rdfs:label "Sentence Charge Reference" ;
    rdfs:comment "A specific charge in a court case resulting in a sentence. NIEM 6.0 j:SentenceCharge. Holds the IRI of the referenced Charge record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-kvz58esku7rnhspb3yk1v8vq a sdc4-meta:ModelComponent ;
    rdfs:label "Act Lifecycle: completed obsolete" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-kwnh9aoww5n6b050zgpb5h0j a sdc4-meta:ModelComponent ;
    rdfs:label "IBIS Number" ;
    rdfs:comment "A number assigned by the Integrated Ballistic Identification System (IBIS) to a bullet or cartridge casing image maintained in the IBIS System which is maintained by the Bureau of Alcohol, Tobacco, and Firearms. NIEM 6.0 j:IBISNumberText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ky56sqir1rncy9vz62s9cygs a sdc4-meta:ModelComponent ;
    rdfs:label "Incident Weapon Involved Indicator" ;
    rdfs:comment "True if a weapon was used in an incident; false otherwise. NIEM 6.0 j:IncidentWeaponInvolvedIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-kyo26nubrheaptga70njjzjd a sdc4-meta:ModelComponent ;
    rdfs:label "Act Lifecycle: suspended active states" ;
    rdfs:comment "States of the suspended active path of the Act Lifecycle workflow, in order: suspended, active. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-kyo7yhvdlvvlije10r063dop a sdc4-meta:ModelComponent ;
    rdfs:label "Disposition Reported Authority" ;
    rdfs:comment "A name of an authority to which a disposition was reported. NIEM 6.0 nc:DispositionReportedAuthorityText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-l2uwnj8sj9c5gu4p900qpftr a sdc4-meta:ModelComponent ;
    rdfs:label "Court Order Recall Date" ;
    rdfs:comment "A date a court order was recalled or rescinded. NIEM 6.0 j:CourtOrderRecallDate." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-l37wmdsuf6t3em6fms7n5huz a sdc4-meta:ModelComponent ;
    rdfs:label "Arrest Bail Recommendation" ;
    rdfs:comment "A bail amount on a schedule recommended according to the offense(s). NIEM 6.0 j:ArrestBailRecommendationText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-l509t0zajfl5atns64d5kl97 a sdc4-meta:ModelComponent ;
    rdfs:label "Name Suffix" ;
    rdfs:comment "A suffix placed after a person's name, such as Jr., Sr., III, PhD, MD or Esq." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-l5gntwbub02e0kr9hpkqe5n6 a sdc4-meta:ModelComponent ;
    rdfs:label "Release" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-l8y97qfew8xc5ocwslvoega3 a sdc4-meta:ModelComponent ;
    rdfs:label "Charge NCIC" ;
    rdfs:comment "A literal description of an offense within the National Crime Information Center (NCIC) system. NIEM 6.0 j:ChargeNCICText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-l9l169co9r23e6fftpvdz4e3 a sdc4-meta:ModelComponent ;
    rdfs:label "Given Name (Person)" ;
    rdfs:comment "The name given to a person at birth or naming, distinguishing them from others in the same family. Also called first name or forename." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-lckcihuej9hiyqfjhekk6nid a sdc4-meta:ModelComponent ;
    rdfs:label "Address Postal Extension Code" ;
    rdfs:comment "An identifier of a smaller area within a post office-assigned zone for an address. NIEM 6.0 nc:AddressPostalExtensionCode." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-lcx80q71lnj2ezglfa83e1fx a sdc4-meta:ModelComponent ;
    rdfs:label "Cordova System Location" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-lerncxh2ohe87vfb1vd18zof a sdc4-meta:ModelComponent ;
    rdfs:label "Charge Recommended Bail Amount" ;
    rdfs:comment "A bail amount on a schedule recommended according to the charge. NIEM 6.0 j:ChargeRecommendedBailAmount. An amount of money in the Default currency units by slot." ;
    sdc4-meta:hasUnit sdc4:mc-hjjou19np3pohe63fxmqtkoi ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-lg5428xoix73dbvzmmv2rp4n a sdc4-meta:ModelComponent ;
    rdfs:label "Item" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-lk48u5opm7u5n31ereji9pyb a sdc4-meta:ModelComponent ;
    rdfs:label "Charge Legal Description" ;
    rdfs:comment "A legal or formal description of a charge. NIEM 6.0 j:ChargeLegalDescriptionText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ll6ltsnvakomixuitxkbkxfz a sdc4-meta:ModelComponent ;
    rdfs:label "Fax Number" ;
    rdfs:comment "A facsimile telephone number, optionally starting with a plus sign and country code, with digits, spaces, hyphens and parentheses allowed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-llps3bgkou8fij8j6hck2hz2 a sdc4-meta:ModelComponent ;
    rdfs:label "Incident Traffic Accident Involved Indicator" ;
    rdfs:comment "True if an incident involved a traffic accident or crash; false otherwise. NIEM 6.0 j:IncidentTrafficAccidentInvolvedIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-lnz214ylxutpxpl6y18yvuai a sdc4-meta:ModelComponent ;
    rdfs:label "Incident Prints Requested Indicator" ;
    rdfs:comment "True if a request was made to gather fingerprints; false otherwise. NIEM 6.0 j:IncidentPrintsRequestedIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-lohvu07ok3c3xvesa16htf2m a sdc4-meta:ModelComponent ;
    rdfs:label "Quarantine End Date" ;
    rdfs:comment """Date the quarantine order was lifted. Null if still active.

---""" ;
    rdfs:isDefinedBy <http://schema.org/endDate> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-lpnc8nbxebzjochs2t2i7cnz a sdc4-meta:ModelComponent ;
    rdfs:label "Item Color Description" ;
    rdfs:comment "A description of the overall color of an item. NIEM 6.0 nc:ItemColorDescriptionText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-lq4eb12aez3w206oix7vvhww a sdc4-meta:ModelComponent ;
    rdfs:label "Charge Special Allegation" ;
    rdfs:comment "A factor that has enhanced a charge, making it a more serious offense. NIEM 6.0 j:ChargeSpecialAllegationText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-lqx9jgmwzhx1ch6y0hnb9rgq a sdc4-meta:ModelComponent ;
    rdfs:label "Item Length" ;
    rdfs:comment "A measurement of the length of an item. NIEM 6.0 nc:ItemLengthMeasure. A quantity in the Length Units (SI and customary)." ;
    sdc4-meta:hasUnit sdc4:mc-p2fnz1w4jahwmljik9bofkhs ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-lsmwiwpvpo8ql4rbradfrfit a sdc4-meta:ModelComponent ;
    rdfs:label "Verdict Issuing Court Reference" ;
    rdfs:comment "A court which issued a verdict. NIEM 6.0 j:VerdictIssuingCourt. Holds the IRI of the referenced Court record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-lsq19vplgdb0lbyepvi14zkv a sdc4-meta:ModelComponent ;
    rdfs:label "Act Lifecycle: suspended nullified states" ;
    rdfs:comment "States of the suspended nullified path of the Act Lifecycle workflow, in order: suspended, nullified. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-lv8mqcuj9r7ka41aa9rhgagt a sdc4-meta:ModelComponent ;
    rdfs:label "Custody Transfer Receiving Enforcement Official Reference" ;
    rdfs:comment "A peace official that receives custody of a subject or property. NIEM 6.0 j:CustodyTransferReceivingEnforcementOfficial. Holds the IRI of the referenced Enforcement Official record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-lx91v2e4tcge56pnodz04b08 a sdc4-meta:ModelComponent ;
    rdfs:label "Charge Reducing Factor" ;
    rdfs:comment "A factor which may make a charge less serious or limit the penalty. NIEM 6.0 j:ChargeReducingFactorText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-lzi428te5jea51vnjeo2mcum a sdc4-meta:ModelComponent ;
    rdfs:label "Release Funds Amount" ;
    rdfs:comment "A numerical amount of the money returned to a subject at the point of release. NIEM 6.0 j:ReleaseFundsAmount. An amount of money in the Default currency units by slot." ;
    sdc4-meta:hasUnit sdc4:mc-hjjou19np3pohe63fxmqtkoi ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-m141vleve8v29a0i3gjrhnq7 a sdc4-meta:ModelComponent ;
    rdfs:label "Item Model Name" ;
    rdfs:comment "A name of a specific design or kind of item made by a manufacturer. NIEM 6.0 nc:ItemModelName." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-m2jbhv431q1p5ip9ex8ik5gw a sdc4-meta:ModelComponent ;
    rdfs:label "Charge Status" ;
    rdfs:comment "A state of a charge. NIEM 6.0 j:ChargeStatus. The status as text (nc:StatusText)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-m2lj6lu22oez88prwrdgmnc2 a sdc4-meta:ModelComponent ;
    rdfs:label "Reporting Officer" ;
    rdfs:comment "The law enforcement officer who filed the incident report. W3C PROV-DM Agent (Person) with badge number as identifier." ;
    rdfs:isDefinedBy prov:Agent,
        schema:Person,
        <https://www.wikidata.org/wiki/Q384593> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#PartyType> .

sdc4:mc-m412ypvtw4s2asyayk6iwk8z a sdc4-meta:ModelComponent ;
    rdfs:label "Evidence Return Recipient Entity Reference" ;
    rdfs:comment "An entity to which a particular piece of property was returned. NIEM 6.0 j:EvidenceReturnRecipientEntity. Holds the IRI of the referenced Entity record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-m58j4hxcdnqe3p9jdbrp3ayb a sdc4-meta:ModelComponent ;
    rdfs:label "Sentence Suspended Indicator" ;
    rdfs:comment "True if the sentence has been suspended; false otherwise. NIEM 6.0 j:SentenceSuspendedIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-m6hyj5gbbwiaepgiioklhtg3 a sdc4-meta:ModelComponent ;
    rdfs:label "Contact Information Description" ;
    rdfs:comment "A description of the contact information. NIEM 6.0 nc:ContactInformationDescriptionText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-m7mirsxi8b4nu0efks502js0 a sdc4-meta:ModelComponent ;
    rdfs:label "Incident Subject Reference" ;
    rdfs:comment "A person whose actions caused an incident. NIEM 6.0 j:IncidentSubject. Holds the IRI of the referenced Subject record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-m7rgncd4zitwrjzupe1hqxwq a sdc4-meta:ModelComponent ;
    rdfs:label "Act Lifecycle: held new states" ;
    rdfs:comment "States of the held new path of the Act Lifecycle workflow, in order: held, new. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-m9z6a3t2900w9yds543iqkzg a sdc4-meta:ModelComponent ;
    rdfs:label "Condition Violation Date" ;
    rdfs:comment "A date a condition was violated. NIEM 6.0 nc:ConditionViolationDate." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-mg8uvjf1apcphfhqy7pj6vgt a sdc4-meta:ModelComponent ;
    rdfs:label "Act Lifecycle: active suspended states" ;
    rdfs:comment "States of the active suspended path of the Act Lifecycle workflow, in order: active, suspended. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-mlh4i1yawch40voxq3ob7aiv a sdc4-meta:ModelComponent ;
    rdfs:label "Court Order Supervising Agency Reference" ;
    rdfs:comment "An agency responsible for evaluating, investigating, supervising and/or setting conditions for a subject incarcerated, on probation, conditional release, supervised release, parole, or otherwise under the jurisdiction of the court, the Department of Corrections, or a Community Corrections Act county. NIEM 6.0 j:CourtOrderSupervisingAgency. Holds the IRI of the referenced Organization record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-mrhq3k775y5xvhsr91dzwrow a sdc4-meta:ModelComponent ;
    rdfs:label "Court Order Service Date" ;
    rdfs:comment "A date a court order was delivered. NIEM 6.0 j:CourtOrderServiceDate." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-mrynj0hqvykgfkni0zity6gp a sdc4-meta:ModelComponent ;
    rdfs:label "Release To Location Reference" ;
    rdfs:comment "A location to which someone or something is released. NIEM 6.0 nc:ReleaseToLocation. Holds the IRI of the referenced Location record." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ms23e2tdxupauf6xn2hqxmrj a sdc4-meta:ModelComponent ;
    rdfs:label "Act Lifecycle: active suspended" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-mti395y9tyk9lf30yi3f7umd a sdc4-meta:ModelComponent ;
    rdfs:label "Statute Offense Enhanceable Indicator" ;
    rdfs:comment "True if a statute refers to an offense that may be made more serious due to circumstances related to the incident; false otherwise. NIEM 6.0 j:StatuteOffenseEnhanceableIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-my0j51q0uv6gqcmnn9eogs3j a sdc4-meta:ModelComponent ;
    rdfs:label "Amber Alert Issued Indicator" ;
    rdfs:comment "True if an Amber Alert has been issued for this incident; false otherwise. NIEM 6.0 j:AmberAlertIssuedIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-n3luxpr7zt9z2ylpmp2wioy4 a sdc4-meta:ModelComponent ;
    rdfs:label "Location Elevation" ;
    rdfs:comment "A measure of the distance of a point on the Earth from a reference point. NIEM 6.0 nc:LocationElevation. A quantity in the Length Units (SI and customary)." ;
    sdc4-meta:hasUnit sdc4:mc-p2fnz1w4jahwmljik9bofkhs ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdQuantityType> .

sdc4:mc-n6kiv2yxuq2an0dnafw3wndy a sdc4-meta:ModelComponent ;
    rdfs:label "Item Image" ;
    rdfs:comment "A binary representation of an image of an item. NIEM 6.0 nc:ItemImage. An image file, by URL." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdFileType> .

sdc4:mc-n8uvz9z7633yqsuwcnni6jzt a sdc4-meta:ModelComponent ;
    rdfs:label "Condition Mandatory Indicator" ;
    rdfs:comment "True if a condition is strictly required; false otherwise. NIEM 6.0 nc:ConditionMandatoryIndicator." ;

sdc4:mc-rw24p8yjm8dmdnvw7egxi2uv-shape a sh:NodeShape ;
    rdfs:label "Education Record Access Control" ;
    rdfs:comment "Access control policy for education records using W3C Data Privacy Vocabulary. Enforces role-based access for school administrators, students, parents, and credentialing bodies. Governs dpv:AcademicData including transcripts, enrollment status, and certifications." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q131156977> ;
            sh:path skos:relatedMatch ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ],
        [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:hasValue <https://w3id.org/dpv#AcademicData> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ] ;
    sh:targetNode sdc4:mc-rw24p8yjm8dmdnvw7egxi2uv ;
    sdc4-meta:sdcType "XdLinkType" .


sdc4:mc-nf1air1zbj8v9w66jozdxmyl-shape a sh:NodeShape ;
    rdfs:label "On Behalf Of Reference" ;
    rdfs:comment "The party on whose behalf the agent acted (FHIR agent.onBehalfOf; prov:actedOnBehalfOf). Holds the IRI of the referenced thing." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://hl7.org/fhir/R4/provenance-definitions.html#Provenance.agent.onBehalfOf> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue sdc4:mc-j9gvyx6u9pb7v1dd0m6joxd6 ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\S+" ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/on-behalf-of-reference> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-nf1air1zbj8v9w66jozdxmyl ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-nj7s1gk45tfgyooxpz0qaha3-shape a sh:NodeShape ;
    rdfs:label "National ID (CID)" ;
    rdfs:comment "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q1140371> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <http://schema.org/identifier> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue schema:identifier ;
            sh:path skos:broadMatch ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "COR-(AL|BR|CE)0[1-3]-[0-9]{6}" ] ;
    sh:targetNode sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-o439m3swa0dj8mil1xmhtz55-shape a sh:NodeShape ;
    rdfs:label "Education In Progress Indicator" ;
    rdfs:comment "True if a person's formal education is still in progress; false otherwise. NIEM 6.0 nc:EducationInProgressIndicator." ;
    sh:node sdc4:XdBooleanBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "true" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/niem-core.xsd> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/niem-core/6.0/EducationInProgressIndicator> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:string ;
            sh:in ( "false" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:false-value ],
        [ sh:hasValue <https://axius-sdc.com/library/niem/education-in-progress-indicator> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-o439m3swa0dj8mil1xmhtz55 ;
    sdc4-meta:sdcType "XdBooleanType" .

sdc4:mc-og08xf6bu928uuz6t3y0e23f-shape a sh:NodeShape ;
    rdfs:label "Acted On Behalf Of Reference" ;
    rdfs:comment "The agent on whose behalf this agent acted (prov:actedOnBehalfOf). Holds the IRI of the referenced thing." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;

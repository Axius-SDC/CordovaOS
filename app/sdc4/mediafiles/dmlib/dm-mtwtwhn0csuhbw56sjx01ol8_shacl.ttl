sdc4:mc-hp420l0x5p6z0tk7nbcpsg0k-shape a sh:NodeShape ;
    rdfs:label "Activity: Main path states" ;
    rdfs:comment "States of the Main path path of the Activity workflow, in order: ActivityProposed, ActivityPlanned, ActivityOngoing, ActivityCompleted. A transition is legal between adjacent states. An activity's lifecycle in the Data Privacy Vocabulary: proposed, planned, ongoing, halted, completed, not completed." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "ActivityProposed" "ActivityPlanned" "ActivityOngoing" "ActivityCompleted" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/activity-lifecycle-main-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://w3id.org/dpv#ActivityStatus> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" "2" "3" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-hp420l0x5p6z0tk7nbcpsg0k ;
    sdc4-meta:sdcType "XdOrdinalType" .


            sh:path sdc4:xdfile-uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdFile media type must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:xdfile-media-type ] ;
    sh:targetClass sdc4:XdFileType .

sdc4:mc-l8f0m7op4xhrxqy1jrnvbuly-shape a sh:NodeShape ;
    rdfs:label "Business Registry Number" ;
    rdfs:comment "Cordova Business Registration Number. Format: BIZ-NNNNNN where NNNNNN is a six-digit sequence number assigned at incorporation. Required for all business filings, tax records, and port authority transactions." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q12047291> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue schema:identifier ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <http://schema.org/identifier> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "BIZ-[0-9]{6}" ] ;
    sh:targetNode sdc4:mc-l8f0m7op4xhrxqy1jrnvbuly ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-nj7s1gk45tfgyooxpz0qaha3-shape a sh:NodeShape ;
    rdfs:label "National ID (CID)" ;
    rdfs:comment "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q1140371> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "COR-(AL|BR|CE)0[1-3]-[0-9]{6}" ],
        [ sh:hasValue <http://schema.org/identifier> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue schema:identifier ;
            sh:path skos:broadMatch ] ;
    sh:targetNode sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:XdLinkBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdLink must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:message "XdLink must have a valid URI" ;
            sh:minCount 1 ;
            sh:path sdc4:xdlink-url ],
        [ sh:datatype xsd:string ;

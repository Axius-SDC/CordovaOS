  <rdf:Description rdf:about="sdc4:mc-rw24p8yjm8dmdnvw7egxi2uv">
    <rdf:type rdf:resource="sdc4-meta:ModelComponent"/>
    <sdc4-meta:isConstrainedByRmComponent rdf:resource="sdc4:XdLinkType"/>
    <rdfs:label>Education Record Access Control</rdfs:label>
    <rdfs:comment>Access control policy for education records using W3C Data Privacy Vocabulary. Enforces role-based access for school administrators, students, parents, and credentialing bodies. Governs dpv:AcademicData including transcripts, enrollment status, and certifications.</rdfs:comment>
    <sdc4-meta:describesConceptualEntity rdf:resource="sdc4:concept-education_record_access_control"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/dpv#AccessControlMethod"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/dpv"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/dpv#AcademicData"/>
  </rdf:Description>

    sh:property [ sh:hasValue <https://uts.nlm.nih.gov/uts/umls/concept/C2030935> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue schema:DefinedTermSet ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:decimal ;

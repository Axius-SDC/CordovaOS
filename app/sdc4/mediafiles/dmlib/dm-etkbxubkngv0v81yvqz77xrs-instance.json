      {
        "component_id": "rl1fs239itr2hdik6iz311t4",
        "label": "Civil Registry Record",
        "type": "Cluster",
        "description": "A resident of the Republic of Cordova as the civil registry holds them: the national ID, the Default person demographics (name, birth date, administrative gender, language, country) by identifier, gender identity (NIEM), the Default contact point, the Cordova address, marital status (HL7 v3, Default) and family relationships. Members: National ID (CID); person-demographics (Default); hs-person-gender-identity-code (NIEM); contact-point (Default); Address (Cordova); marital-status (Default); Family Relationship.",
        "items": [
          {
            "component_id": "nj7s1gk45tfgyooxpz0qaha3",
            "label": "National ID (CID)",
            "type": "XdString",
            "description": "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions.",
            "value": "DefaultString"
          },
          {
            "component_id": "jehcvvbkw36i1ecd5ooqbwp9",
            "label": "Person Gender Identity Code",
            "type": "XdToken",
            "description": "A gender of a person's identity. The cultural meanings of patterns of behavior, experience, and personality that are labeled masculine or feminine. NIEM 6.0 hs:PersonGenderIdentityCode. Codes of hs:PersonGenderIdentityCodeSimpleType (9 values).",
            "value": "Male",
            "constraints": {
              "enumerations": [
                "Did not disclose",
                "Female",
                "Genderqueer/Gender Non-conforming",
                "Intersex/Non-binary gender",
                "Male",
                "Transgender Female to Male (FTM)",
                "Transgender General",
                "Transgender Male to Female (MTF)",
                "Unknown"
              ]
            }
          },
          {
            "component_id": "z11vs0cvonack540omgwhxhz",
            "label": "Marital Status",
            "type": "XdToken",
            "description": "The marital or civil status of a person, using the HL7 v3 MaritalStatus code system.",
            "value": "A",
            "constraints": {
              "enumerations": [
                "A",
                "C",
                "D",
                "I",
                "L",
                "M",
                "P",
                "S",
                "T",
                "U",
                "W"
              ]
            }
          },
          {

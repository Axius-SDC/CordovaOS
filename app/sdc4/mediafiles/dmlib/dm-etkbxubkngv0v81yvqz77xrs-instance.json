            "label": "Data Subject Reference",
            "type": "XdString",
            "description": "The data subject or patient the event concerns (FHIR AuditEvent.patient; SDC DM.subject). Holds the IRI of the referenced thing.",
            "value": "DefaultString",
            "constraints": {
              "max_length": 2000
            }
          },
          {
            "component_id": "nf1air1zbj8v9w66jozdxmyl",
            "label": "On Behalf Of Reference",
            "type": "XdString",
            "description": "The party on whose behalf the agent acted (FHIR agent.onBehalfOf; prov:actedOnBehalfOf). Holds the IRI of the referenced thing.",
            "value": "DefaultString",
            "constraints": {
              "max_length": 2000
            }
          },
          {
            "component_id": "h3kdbvdtyalpvik97saaf0an",
            "label": "System Identifier",
            "type": "XdString",

                "component_id": "sexw93x5276zwsn1qx15htpv",
                "label": "Address (Line 2)",
                "type": "XdString",
                "description": "The second line of a street address: apartment, suite, unit, building or floor, when the first line does not carry it.",
                "value": "DefaultString",
                "constraints": {
                  "max_length": 200
                }
              },
              {
                "component_id": "gf841eedvv6cjiegs934srai",
                "label": "Postal Code",

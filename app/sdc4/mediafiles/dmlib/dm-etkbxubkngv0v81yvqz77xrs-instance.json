  "data": {
    "component_id": "jkl2gufrtpbp8gpno35b7wiy",
    "label": "Civil Registry Governed Record",
    "type": "Cluster",
    "description": "A civil registry record. The governed record: the data cluster, the PROV activity and agent and the audit event from the ProvGov library by identifier, and the digital signature proof. Members: Civil Registry Record; prov-activity (Provgov); prov-agent (Provgov); audit-event (Provgov); Digital Signature Proof.",
    "items": [
      {
        "component_id": "gug5dhtqfv7exbgmm2raxpkq",
        "label": "Digital Signature Proof",
        "type": "XdFile",
        "description": "Cryptographic proof of attestation (digital signature)",
        "value": "/path/to/sample/file.txt"
      },
      {
        "component_id": "t2tvd3wylxrstdeu5aw6gkw1",
        "label": "Audit Event",
        "type": "Cluster",
        "description": "A logged access or custody event as data: what was done, by whom, on what, with what outcome and for what purpose. The audit-only case of sdc5 issue 002; state-changing operations are workflow transitions.",
        "items": [
          {
            "component_id": "dkc2ccj5te35z9gd4bu1blcq",
            "label": "Audit Agent Reference",
            "type": "XdString",
            "description": "The acting agent (FHIR AuditEvent.agent.who). Holds the IRI of the referenced thing.",
            "value": "DefaultString",
            "constraints": {
              "max_length": 2000
            }
          },
          {
            "component_id": "gcjyjrnp0wsfoelcp4m05c67",
            "label": "Audit Entity Reference",
            "type": "XdString",
            "description": "The entity the event concerns (FHIR AuditEvent.entity.what). Holds the IRI of the referenced thing.",
            "value": "DefaultString",
            "constraints": {
              "max_length": 2000
            }
          },
          {
            "component_id": "fjhgr5fyqxt2crmg2cb5c513",
            "label": "Audit Event Identifier",
            "type": "XdString",

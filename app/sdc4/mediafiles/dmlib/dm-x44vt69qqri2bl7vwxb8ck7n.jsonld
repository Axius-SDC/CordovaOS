  "components": [
    {
      "@type": "ClusterType",
      "@id": "sdc4:mc-jyx3v449tku745yxm6hte0eg",
      "label": "Property Registry Governed Record",
      "description": "Root data cluster (DMType Item) for a governed property-registry record in CordovaOS: a parcel's title, ownership, and transfers. Wraps the domain's data components with the shared W3C PROV-O Provenance cluster so each record carries its lineage bound alongside its data. Workflow, attestation, parties, and the system audit trail sit in the DMType's native governance slots; access control and retention apply as bound sdcgovernance policy.",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "contains": [],

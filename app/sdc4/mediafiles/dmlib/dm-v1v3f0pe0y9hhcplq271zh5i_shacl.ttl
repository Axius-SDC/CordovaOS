sdc4:mc-tw8mn0vv8z8v3w533gfu9j92-shape a sh:NodeShape ;
    rdfs:label "Employment Record Access Control" ;
    rdfs:comment "Access control policy for employment records using W3C Data Privacy Vocabulary. Enforces role-based access for employers, employees, and labor authorities. Governs dpv:ProfessionalData including employment history, salary records, and workplace certifications." ;

            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q627374> ;
            sh:path skos:relatedMatch ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:hasValue <https://w3id.org/dpv#ProfessionalData> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ] ;
    sh:targetNode sdc4:mc-tw8mn0vv8z8v3w533gfu9j92 ;
    sdc4-meta:sdcType "XdLinkType" .


    rdfs:label "Address Urbanization Name" ;
    rdfs:comment "An urbanization denotes an area, sector, or residential development within a geographic area. Commonly used in Puerto Rican urban areas, it is an important part of the addressing format, as it describes the location of a specific street whose name may occur multiple times within the same ZIP Code. NIEM 6.0 nc:AddressUrbanizationName." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;

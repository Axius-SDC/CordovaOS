sdc4:mc-htekeop7yycwh1pvay3ik336-shape a sh:NodeShape ;
    rdfs:label "Asset Status: Main path states" ;
    rdfs:comment "States of the Main path path of the Asset Status workflow, in order: UnderDevelopment, Completed, Deprecated, Withdrawn. A transition is legal between adjacent states. The status of a reusable asset per the W3C Asset Description Metadata Schema: under development, completed, deprecated, withdrawn." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "UnderDevelopment" "Completed" "Deprecated" "Withdrawn" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" "2" "3" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <https://www.w3.org/TR/vocab-adms/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/asset-status-main-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <http://purl.org/adms/status/1.0> ;
            sh:path skos:closeMatch ] ;
    sh:targetNode sdc4:mc-htekeop7yycwh1pvay3ik336 ;
    sdc4-meta:sdcType "XdOrdinalType" .


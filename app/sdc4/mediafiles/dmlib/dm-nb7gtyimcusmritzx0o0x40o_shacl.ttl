sdc4:mc-dr8983b4k8ngg02x78lrw560-shape a sh:NodeShape ;
    rdfs:label "Business Registration Protocol" ;
    rdfs:comment "Protocol reference for the Business Registry data model. Informed by the UNCITRAL Model Law on Business Registries, national commercial registration codes, and the UN/CEFACT Core Component Library for standardized business entity representation." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 500 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path sdc4:xdstring-value ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q317623> ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q132364> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q483908> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-dr8983b4k8ngg02x78lrw560 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-ksvt73kzyktevaumrh5djpe7-shape a sh:NodeShape ;
    rdfs:label "Business Registry Access Control" ;
    rdfs:comment "Access control policy for business registration data using W3C Data Privacy Vocabulary. Enforces role-based access for registry clerks, business owners, and authorized agents. Governs dpv:CommercialData including registration documents, ownership records, and compliance filings." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <https://w3id.org/dpv#CommercialData> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q1423020> ;
            sh:path skos:relatedMatch ] ;
    sh:targetNode sdc4:mc-ksvt73kzyktevaumrh5djpe7 ;
    sdc4-meta:sdcType "XdLinkType" .


sdc4:mc-jd9i1lg4h06yjphcjsmnllq1-shape a sh:NodeShape ;
    rdfs:label "Asset Status: completed withdrawn states" ;
    rdfs:comment "States of the completed withdrawn path of the Asset Status workflow, in order: Completed, Withdrawn. A transition is legal between adjacent states. The status of a reusable asset per the W3C Asset Description Metadata Schema: under development, completed, deprecated, withdrawn." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/asset-status-completed-withdrawn-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://www.w3.org/TR/vocab-adms/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://purl.org/adms/status/1.0> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:string ;
            sh:in ( "Completed" "Withdrawn" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ] ;
    sh:targetNode sdc4:mc-jd9i1lg4h06yjphcjsmnllq1 ;
    sdc4-meta:sdcType "XdOrdinalType" .


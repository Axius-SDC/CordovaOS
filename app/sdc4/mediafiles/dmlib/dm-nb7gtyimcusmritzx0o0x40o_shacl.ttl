            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://schema.org/City> ;
            sh:path rdfs:isDefinedBy ] ;
    sh:targetNode sdc4:mc-atdtdfzruh7tya0iv5cz365l ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-ayhhnde5u8fw23pr2hq7frzg-shape a sh:NodeShape ;
    rdfs:label "Organization Parent Organization Reference" ;
    rdfs:comment "An organization that owns, controls, or operates the organization. NIEM 6.0 nc:OrganizationParentOrganization. Holds the IRI of the referenced Organization record." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com/library/niem/organization-parent-organization-reference> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\S+" ],

        },
        {
          "predicate": "http://purl.org/dc/terms/source",
          "object": "https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/hs.xsd"
        },
        {
          "predicate": "http://www.w3.org/2004/02/skos/core#exactMatch",
          "object": "https://docs.oasis-open.org/niemopen/ns/model/domains/humanServices/6.0/PersonGenderIdentityCode"
        },
        {
          "predicate": "http://www.w3.org/2004/02/skos/core#exactMatch",
          "object": "https://docs.oasis-open.org/niemopen/ns/model/domains/humanServices/6.0/PersonGenderIdentityCodeSimpleType"
        }
      ]
    },

    {
      "@type": "XdStringType",
      "@id": "sdc4:mc-nj7s1gk45tfgyooxpz0qaha3",
      "label": "National ID (CID)",
      "description": "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions.",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "constraints": {
        "pattern": "COR-(AL|BR|CE)0[1-3]-[0-9]{6}"
      },
      "dataType": "xsd:string",
      "semanticLinks": [
        {
          "predicate": "http://www.w3.org/2000/01/rdf-schema#isDefinedBy",
          "object": "http://schema.org/identifier"
        },
        {
          "predicate": "http://www.w3.org/2000/01/rdf-schema#isDefinedBy",
          "object": "https://www.wikidata.org/wiki/Q1140371"
        },
        {
          "predicate": "http://www.w3.org/2004/02/skos/core#broadMatch",
          "object": "https://schema.org/identifier"
        }
      ]
    },
    {
      "@type": "XdTokenType",
      "@id": "sdc4:mc-jehcvvbkw36i1ecd5ooqbwp9",
      "label": "Person Gender Identity Code",
      "description": "A gender of a person's identity. The cultural meanings of patterns of behavior, experience, and personality that are labeled masculine or feminine. NIEM 6.0 hs:PersonGenderIdentityCode. Codes of hs:PersonGenderIdentityCodeSimpleType (9 values).",
      "cardinality": {
        "minOccurs": 0,
        "maxOccurs": 1
      },
      "constraints": {
        "enumeration": [
          "Did not disclose",
          "Female",
          "Genderqueer/Gender Non-conforming",
          "Intersex/Non-binary gender",
          "Male",
          "Transgender Female to Male (FTM)",
          "Transgender General",
          "Transgender Male to Female (MTF)",
          "Unknown"
        ]
      },
      "dataType": "xsd:token",
      "semanticLinks": [
        {
          "predicate": "http://purl.org/dc/terms/publisher",
          "object": "https://axius-sdc.com"
        },
        {

sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 a sdc4-meta:ModelComponent ;
    rdfs:label "National ID (CID)" ;
    rdfs:comment "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions." ;
    rdfs:isDefinedBy <http://schema.org/identifier>,
        <https://www.wikidata.org/wiki/Q1140371> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-o439m3swa0dj8mil1xmhtz55 a sdc4-meta:ModelComponent ;
    rdfs:label "Education In Progress Indicator" ;
    rdfs:comment "True if a person's formal education is still in progress; false otherwise. NIEM 6.0 nc:EducationInProgressIndicator." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdBooleanType> .

sdc4:mc-o87tv977uxnegwckzso3xf4z a sdc4-meta:ModelComponent ;
    rdfs:label "Education Record Attested View" ;
    rdfs:comment "Attested view of an education record document" ;

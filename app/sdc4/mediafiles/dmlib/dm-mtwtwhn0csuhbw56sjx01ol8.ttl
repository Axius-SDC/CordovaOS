    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-qb90a0sp9vvb6c5cbcf236ys a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Email" ;
    rdfs:comment "The agent's email address (foaf:mbox)." ;

sdc4:mc-aw1hrptamag4xuobxj5hg54i-shape a sh:NodeShape ;
    rdfs:label "Encounter: Main path states" ;
    rdfs:comment "States of the Main path path of the Encounter workflow, in order: planned, arrived, triaged, in-progress, finished. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "planned" "arrived" "triaged" "in-progress" "finished" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <http://hl7.org/fhir/encounter-status> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/encounter-lifecycle-main-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" "2" "3" "4" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-aw1hrptamag4xuobxj5hg54i ;
    sdc4-meta:sdcType "XdOrdinalType" .


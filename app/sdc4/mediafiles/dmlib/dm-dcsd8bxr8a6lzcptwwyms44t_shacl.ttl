sdc4:mc-emov6wuhen2tuyjlppqmmjjl-shape a sh:NodeShape ;
    rdfs:label "Healthcare Records Protocol" ;
    rdfs:comment "Protocol reference for the Healthcare Record data model. Informed by the WHO International Classification of Diseases (ICD-11), HL7 FHIR resource concepts for clinical data exchange, and national health information management standards for patient records." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q35869> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q317623> ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q132364> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 500 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path sdc4:xdstring-value ] ;
    sh:targetNode sdc4:mc-emov6wuhen2tuyjlppqmmjjl ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-hbk1xmzqefk2lchmd7jooz7a-shape a sh:NodeShape ;
    rdfs:label "Healthcare Record Access Control" ;
    rdfs:comment "Access control policy for healthcare data using W3C Data Privacy Vocabulary. Enforces role-based access for healthcare providers, patients, and authorized representatives. Governs dpv:SpecialCategoryPersonalData including medical records, diagnoses, and treatment plans." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q1324077> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ],
        [ sh:hasValue <https://w3id.org/dpv#SpecialCategoryPersonalData> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ] ;
    sh:targetNode sdc4:mc-hbk1xmzqefk2lchmd7jooz7a ;
    sdc4-meta:sdcType "XdLinkType" .


        [ sh:datatype xsd:string ;
            sh:in ( "true" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue sdc4:mc-rzdgsf3aabgupdv5im1mp7yc ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/immunization-definitions.html#Immunization.reaction.reported> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-myydvf1ehbqoor9vaddpdvt1 ;
    sdc4-meta:sdcType "XdBooleanType" .


    sh:targetNode sdc4:mc-m11tmjzf44tof6c48hnjxbz3 ;
    sdc4-meta:sdcType "XdTemporalType" .

sdc4:mc-mbps1zq317i8qumieyzwz1nf-shape a sh:NodeShape ;
    rdfs:label "Encounter: triaged cancelled states" ;
    rdfs:comment "States of the triaged cancelled path of the Encounter workflow, in order: triaged, cancelled. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com/library/provgov/encounter-lifecycle-triaged-cancelled-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://hl7.org/fhir/encounter-status> ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:string ;
            sh:in ( "triaged" "cancelled" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-mbps1zq317i8qumieyzwz1nf ;
    sdc4-meta:sdcType "XdOrdinalType" .

sdc4:mc-mf5zu92mgdam65gs9djp1t4g-shape a sh:NodeShape ;
    rdfs:label "Reaction Description" ;
    rdfs:comment "A description of the reaction. FHIR AllergyIntolerance.reaction.description." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue sdc4:mc-byizx3nh3rzaeks1wf7x1m28 ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/allergyintolerance-definitions.html#AllergyIntolerance.reaction.description> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 4000 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/reaction-description> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-mf5zu92mgdam65gs9djp1t4g ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-miqo30r5b554nyj7ubryw43x-shape a sh:NodeShape ;
    rdfs:label "Contact Method" ;
    rdfs:comment "The communication channel of a contact point." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:datatype xsd:token ;
            sh:in ( "phone" "fax" "email" "pager" "url" "sms" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://hl7.org/fhir/contact-point-system> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue sdc4:mc-tf5wlywn6meurn6o1sz8yuaq ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/default/contact-method> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-miqo30r5b554nyj7ubryw43x ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-mpkqsp6zn1gbc1zhqai9y40b-shape a sh:NodeShape ;
    rdfs:label "Encounter Status" ;
    rdfs:comment "The lifecycle state of the encounter. FHIR Encounter.status; EncounterStatus, version 4.0.1." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:datatype xsd:token ;
            sh:in ( "planned" "arrived" "triaged" "in-progress" "onleave" "finished" "cancelled" "entered-in-error" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://hl7.org/fhir/R4/encounter-definitions.html#Encounter.status> ;
            sh:path skos:closeMatch ],
        [ sh:hasValue sdc4:mc-yq8mjdfv83g4l9cauiwxaxof ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/encounter-status> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://hl7.org/fhir/encounter-status> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-mpkqsp6zn1gbc1zhqai9y40b ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-mrti6abfhdeferd4xsm9kz1b-shape a sh:NodeShape ;
    rdfs:label "Last Reaction Date" ;
    rdfs:comment "When the last reaction occurred. FHIR AllergyIntolerance.lastOccurrence." ;
    sh:node sdc4:XdTemporalBaseShape ;
    sh:property [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://hl7.org/fhir/R4/allergyintolerance-definitions.html#AllergyIntolerance.lastOccurrence> ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtemporal-datetime ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/last-reaction-date> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue sdc4:mc-dxfyi0b20o30te7jjq8btf6w ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-mrti6abfhdeferd4xsm9kz1b ;
    sdc4-meta:sdcType "XdTemporalType" .

sdc4:mc-mt8638gzmop40mv6u6251irh-shape a sh:NodeShape ;
    rdfs:label "Target Disease Code (SNOMED CT)" ;
    rdfs:comment "The SNOMED CT code for the disease the vaccine protects against. FHIR Immunization.protocolApplied.targetDisease, coded in http://snomed.info/sct." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <http://snomed.info/sct> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "[0-9]{6,18}" ],
        [ sh:hasValue <http://snomed.info/sct> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue sdc4:mc-l3a552ow4oot6h2yug26dwlv ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/immunization-definitions.html#Immunization.protocolApplied.targetDisease> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/target-disease-code> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-mt8638gzmop40mv6u6251irh ;
    sdc4-meta:sdcType "XdStringType" .


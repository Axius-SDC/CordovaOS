    rdfs:comment "Whether the dose is known to be subpotent. FHIR Immunization.isSubpotent." ;
    sh:node sdc4:XdBooleanBaseShape ;
    sh:property [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue sdc4:mc-cblq6fw17gdebo4u89638rn9 ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/is-subpotent> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:in ( "true" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ],
        [ sh:datatype xsd:string ;
            sh:in ( "false" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:false-value ],
        [ sh:hasValue <http://hl7.org/fhir/R4/immunization-definitions.html#Immunization.isSubpotent> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-lt7xu3wvixu66e818ii8d3qf ;
    sdc4-meta:sdcType "XdBooleanType" .

sdc4:mc-ludhh6euu3lc99wpik2pyjcc-shape a sh:NodeShape ;
    rdfs:label "Allergy Category" ;
    rdfs:comment "The category of the substance. FHIR AllergyIntolerance.category; AllergyIntoleranceCategory, version 4.0.1." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue sdc4:mc-dmzga6k8s3ewhptvgcw7bemy ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:token ;
            sh:in ( "food" "medication" "environment" "biologic" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://hl7.org/fhir/allergy-intolerance-category> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/allergy-category> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://hl7.org/fhir/R4/allergyintolerance-definitions.html#AllergyIntolerance.category> ;
            sh:path skos:closeMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-ludhh6euu3lc99wpik2pyjcc ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-lvms8v52hnfpiqinfbwwtw37-shape a sh:NodeShape ;
    rdfs:label "Allergy Onset Date" ;
    rdfs:comment "When the allergy was identified. FHIR AllergyIntolerance.onsetDateTime." ;
    sh:node sdc4:XdTemporalBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtemporal-datetime ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/allergy-onset-date> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue sdc4:mc-vsb9m1e7vmm8sz58hm9qaiay ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/allergyintolerance-definitions.html#AllergyIntolerance.onsetDateTime> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-lvms8v52hnfpiqinfbwwtw37 ;
    sdc4-meta:sdcType "XdTemporalType" .

sdc4:mc-m11tmjzf44tof6c48hnjxbz3-shape a sh:NodeShape ;
    rdfs:label "Reaction Onset" ;
    rdfs:comment "When the reaction began. FHIR AllergyIntolerance.reaction.onset." ;
    sh:node sdc4:XdTemporalBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],

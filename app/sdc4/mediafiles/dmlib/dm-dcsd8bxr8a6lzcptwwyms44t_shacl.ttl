sdc4:mc-e8zpir2mt00pvdwmkh0cfd99-shape a sh:NodeShape ;
    rdfs:label "Encounter: arrived cancelled states" ;
    rdfs:comment "States of the arrived cancelled path of the Encounter workflow, in order: arrived, cancelled. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:in ( "arrived" "cancelled" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <http://hl7.org/fhir/encounter-status> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/encounter-lifecycle-arrived-cancelled-states> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ] ;
    sh:targetNode sdc4:mc-e8zpir2mt00pvdwmkh0cfd99 ;
    sdc4-meta:sdcType "XdOrdinalType" .


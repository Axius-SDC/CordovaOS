            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-fo7mfnovqd9ef2yzcfax2fqe ;

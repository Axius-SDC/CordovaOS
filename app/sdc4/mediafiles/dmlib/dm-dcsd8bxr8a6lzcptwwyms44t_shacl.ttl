            sh:in ( "in-progress" "onleave" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/encounter-lifecycle-in-progress-onleave-states> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-x1g2wcwrow5f25epkmfbx6vo ;

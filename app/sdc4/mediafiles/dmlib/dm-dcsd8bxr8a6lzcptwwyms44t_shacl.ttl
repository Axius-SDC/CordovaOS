sdc4:mc-n2t9mb13f091rmr9ybaq40dc-shape a sh:NodeShape ;
    rdfs:label "Encounter: in progress entered in error states" ;
    rdfs:comment "States of the in progress entered in error path of the Encounter workflow, in order: in-progress, entered-in-error. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:in ( "in-progress" "entered-in-error" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://hl7.org/fhir/encounter-status> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/encounter-lifecycle-in-progress-entered-in-error-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ] ;
    sh:targetNode sdc4:mc-n2t9mb13f091rmr9ybaq40dc ;
    sdc4-meta:sdcType "XdOrdinalType" .

sdc4:mc-n7s7hcgef4pxius8a0l6r5qp-shape a sh:NodeShape ;
    rdfs:label "Mass/Weight (SI - Metric)" ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <http://qudt.org/> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ],
        [ sh:hasValue <http://qudt.org/vocab/quantitykind/Mass> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/default/units-mass-si> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue sdc4:mc-tjxxdsd6idyzqygrncojauxn ;
            sh:path prov:wasRevisionOf ] ;
    sh:targetNode sdc4:mc-n7s7hcgef4pxius8a0l6r5qp ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-ncxxt7wgs7soxw7kbmapxvg3-shape a sh:NodeShape ;
    rdfs:label "Address (Line 1)" ;
    rdfs:comment "The first line of a street address: street number and name, or a post office box." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue schema: ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 200 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ],
        [ sh:hasValue schema:streetAddress ;
            sh:path skos:exactMatch ],
        [ sh:hasValue sdc4:mc-l338k7nlvnq2am0owa19yxfc ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://axius-sdc.com/library/default/address-line-1> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-ncxxt7wgs7soxw7kbmapxvg3 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-ndvtjiq0cke0q1trw58rtrq2-shape a sh:NodeShape ;
    rdfs:label "person_given_name" ;
    rdfs:comment "Given (first) name of the person agent." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q202444> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 100 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path sdc4:xdstring-value ] ;
    sh:targetNode sdc4:mc-ndvtjiq0cke0q1trw58rtrq2 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-nesxtz8c5o665swc9lhvqkjj-shape a sh:NodeShape ;
    rdfs:label "PROV Agent Type" ;
    rdfs:comment "Classification of agents responsible for activities and entities in W3C PROV-DM. Agents bear responsibility for activities and entity generation." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue prov:Agent ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue schema:DefinedTermSet ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:token ;
            sh:in ( "Person" "Organization" "SoftwareAgent" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ] ;
    sh:targetNode sdc4:mc-nesxtz8c5o665swc9lhvqkjj ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-nf1air1zbj8v9w66jozdxmyl-shape a sh:NodeShape ;
    rdfs:label "On Behalf Of Reference" ;
    rdfs:comment "The party on whose behalf the agent acted (FHIR agent.onBehalfOf; prov:actedOnBehalfOf). Holds the IRI of the referenced thing." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue sdc4:mc-j9gvyx6u9pb7v1dd0m6joxd6 ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/on-behalf-of-reference> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\S+" ],
        [ sh:hasValue <http://hl7.org/fhir/R4/provenance-definitions.html#Provenance.agent.onBehalfOf> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-nf1air1zbj8v9w66jozdxmyl ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-nj7s1gk45tfgyooxpz0qaha3-shape a sh:NodeShape ;
    rdfs:label "National ID (CID)" ;
    rdfs:comment "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue schema:identifier ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <http://schema.org/identifier> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q1140371> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "COR-(AL|BR|CE)0[1-3]-[0-9]{6}" ] ;
    sh:targetNode sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-no649c8yiebkyujhlbwjuppx-shape a sh:NodeShape ;
    rdfs:label "Language Code" ;
    rdfs:comment "The ISO 639-1 two-letter code of a language: the complete list of 184 codes, which are also the BCP 47 primary language subtags. Each value is defined by its Wikidata entity." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue sdc4:mc-w7t802u535su9576z02uw71o ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://www.iso.org/iso-639-language-code> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://purl.obolibrary.org/obo/NCIT_C16779> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;

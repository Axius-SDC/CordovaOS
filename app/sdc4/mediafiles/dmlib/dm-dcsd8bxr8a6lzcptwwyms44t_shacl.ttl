sdc4:mc-x1g2wcwrow5f25epkmfbx6vo-shape a sh:NodeShape ;
    rdfs:label "Encounter: in progress onleave states" ;
    rdfs:comment "States of the in progress onleave path of the Encounter workflow, in order: in-progress, onleave. A transition is legal between adjacent states. The FHIR Encounter lifecycle: planned, arrived, triaged, in progress, on leave, finished, cancelled." ;

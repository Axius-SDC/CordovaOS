sdc4:mc-onj0p50oeldicgsyn89zdur8-shape a sh:NodeShape ;
    rdfs:label "Activity: activityhalted activityongoing states" ;
    rdfs:comment "States of the activityhalted activityongoing path of the Activity workflow, in order: ActivityHalted, ActivityOngoing. A transition is legal between adjacent states. An activity's lifecycle in the Data Privacy Vocabulary: proposed, planned, ongoing, halted, completed, not completed." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "ActivityHalted" "ActivityOngoing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://w3id.org/dpv#ActivityStatus> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/activity-lifecycle-activityhalted-activityongoing-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-onj0p50oeldicgsyn89zdur8 ;
    sdc4-meta:sdcType "XdOrdinalType" .


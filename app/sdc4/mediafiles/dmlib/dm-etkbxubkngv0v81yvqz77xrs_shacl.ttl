    sh:property [ sh:hasValue <https://axius-sdc.com/library/default/administrative-gender> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:token ;
            sh:in ( "male" "female" "other" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://hl7.org/fhir/administrative-gender> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue sdc4:mc-tnyh2ude3db9smwfin0vai5h ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;

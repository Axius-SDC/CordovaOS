sdc4:mc-fdwlhbher1gm91zfmf8mno6c-shape a sh:NodeShape ;
    rdfs:label "Civil Registry Access Control" ;
    rdfs:comment "Access control policy for civil registration data using W3C Data Privacy Vocabulary. Enforces role-based access for registry officials, citizens, and legal representatives. Governs dpv:IdentifyingPersonalData including birth, marriage, and death records." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://w3id.org/dpv#IdentifyingPersonalData> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q83708009> ;
            sh:path rdfs:isDefinedBy ] ;
    sh:targetNode sdc4:mc-fdwlhbher1gm91zfmf8mno6c ;
    sdc4-meta:sdcType "XdLinkType" .


sdc4:mc-zpfwg52r88j6jdypj7rg71ke-shape a sh:NodeShape ;
    rdfs:label "Phone Number" ;
    rdfs:comment "A telephone number, optionally starting with a plus sign and country code, with digits, spaces, hyphens and parentheses allowed." ;

sdc4:mc-i2vrm5bvxw03tcoesvgnft64-shape a sh:NodeShape ;
    rdfs:label "Relationship to Subject" ;
    rdfs:comment "How a contact person is related to the subject of the record, from the HL7 v3 RoleCode personal relationship codes." ;

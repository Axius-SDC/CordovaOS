sdc4:mc-ll6ltsnvakomixuitxkbkxfz-shape a sh:NodeShape ;
    rdfs:label "Fax Number" ;
    rdfs:comment "A facsimile telephone number, optionally starting with a plus sign and country code, with digits, spaces, hyphens and parentheses allowed." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue sdc4:mc-hzpld81b2ddnp5qywombgpls ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue schema:faxNumber ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://www.itu.int/rec/T-REC-E.164> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\+?\\d[\\d\\s\\-\\(\\)]{6,18}" ],
        [ sh:hasValue <https://axius-sdc.com/library/default/fax-number> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-ll6ltsnvakomixuitxkbkxfz ;
    sdc4-meta:sdcType "XdStringType" .


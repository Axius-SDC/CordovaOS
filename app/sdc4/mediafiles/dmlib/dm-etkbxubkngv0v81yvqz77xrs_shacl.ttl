            sh:path sdc4:xdstring-value ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://www.wikidata.org/entity/Q202444> ;
            sh:path skos:closeMatch ],
        [ sh:hasValue <https://axius-sdc.com/library/default/given-name-person> ;

            sh:path dcterms:identifier ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-i2vrm5bvxw03tcoesvgnft64 ;
    sdc4-meta:sdcType "XdTokenType" .


sdc4:mc-q922mqaon3yn5zlwf2bszf28-shape a sh:NodeShape ;
    rdfs:label "Email Address" ;
    rdfs:comment "An email address. The pattern requires a local part, an at sign and a domain with a dot; RFC 5321 limits the whole address to 254 characters." ;

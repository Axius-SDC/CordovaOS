            sh:pattern ".+@.+\\..+" ],
        [ sh:hasValue <https://www.rfc-editor.org/rfc/rfc5321> ;
            sh:path dcterms:source ],
        [ sh:hasValue schema:email ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com/library/default/email-address> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-q922mqaon3yn5zlwf2bszf28 ;
    sdc4-meta:sdcType "XdStringType" .


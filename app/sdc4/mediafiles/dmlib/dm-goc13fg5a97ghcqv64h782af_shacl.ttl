            sh:in ( "0" "1" "2" "3" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ] ;
    sh:targetNode sdc4:mc-htekeop7yycwh1pvay3ik336 ;
    sdc4-meta:sdcType "XdOrdinalType" .


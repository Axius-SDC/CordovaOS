sdc4:mc-sl027mwr4zjo3ht4yeslb0ti-shape a sh:NodeShape ;
    rdfs:label "Property Registry Access Control" ;
    rdfs:comment "Access control policy for property registration data using W3C Data Privacy Vocabulary. Enforces role-based access for registry officials, property owners, and legal representatives. Governs dpv:FinancialData including title deeds, cadastral records, and encumbrance filings." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ],
        [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://w3id.org/dpv#FinancialData> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q66502406> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ] ;
    sh:targetNode sdc4:mc-sl027mwr4zjo3ht4yeslb0ti ;
    sdc4-meta:sdcType "XdLinkType" .


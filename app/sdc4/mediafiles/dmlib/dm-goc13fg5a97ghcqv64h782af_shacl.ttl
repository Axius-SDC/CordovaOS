    sh:property [ sh:hasValue <http://purl.org/adms/status/1.0> ;
            sh:path skos:closeMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <https://www.w3.org/TR/vocab-adms/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/asset-status-underdevelopment-withdrawn-states> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:in ( "UnderDevelopment" "Withdrawn" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-cghpinwzc0wieilpck5f5ekm ;
    sdc4-meta:sdcType "XdOrdinalType" .


sdc4:mc-jujsdur1igws8orw6tvvlqco-shape a sh:NodeShape ;
    rdfs:label "Provenance Agent Type" ;
    rdfs:comment "The functional role of an agent in an activity (FHIR Provenance.agent.type)." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue <http://terminology.hl7.org/CodeSystem/provenance-participant-type> ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:token ;

sdc4:mc-ht98owgvxhff3ge85i4h80lp-shape a sh:NodeShape ;
    rdfs:label "Yes/No" ;
    rdfs:comment "Standard Yes/No binary response for clinical data collection" ;
    sh:node sdc4:XdBooleanBaseShape ;
    sh:property [ sh:hasValue schema:DefinedTermSet ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q113518417> ;
            sh:path skos:relatedMatch ],
        [ sh:datatype xsd:string ;
            sh:in ( "Yes" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ],
        [ sh:datatype xsd:string ;
            sh:in ( "No" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:false-value ] ;
    sh:targetNode sdc4:mc-ht98owgvxhff3ge85i4h80lp ;
    sdc4-meta:sdcType "XdBooleanType" .

sdc4:mc-ifw5zfe4oiijbxjn1ylc2wm3-shape a sh:NodeShape ;
    rdfs:label "organization_name" ;
    rdfs:comment "Legal or official name of the organization." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q168678> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 200 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path sdc4:xdstring-value ] ;
    sh:targetNode sdc4:mc-ifw5zfe4oiijbxjn1ylc2wm3 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-jtuheuri2wzfhctcjqv4ozmy-shape a sh:NodeShape ;
    rdfs:label "contact_email" ;
    rdfs:comment "Contact email for the service." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern ".+@.+\\..+" ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q1273217> ;
            sh:path rdfs:isDefinedBy ] ;
    sh:targetNode sdc4:mc-jtuheuri2wzfhctcjqv4ozmy ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-kv5qqs3o4jwcwz9javgw1pzh-shape a sh:NodeShape ;
    rdfs:label "Province" ;
    rdfs:comment "One of the three provinces of the Republic of Cordova. Used across civil registry, property, tax, and all geographic records." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:datatype xsd:token ;
            sh:in ( "Aldara" "Brevina" "Celara" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue schema:State ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue schema:DefinedTermSet ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://schema.org/AdministrativeArea> ;
            sh:path rdfs:isDefinedBy ] ;
    sh:targetNode sdc4:mc-kv5qqs3o4jwcwz9javgw1pzh ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-l8f0m7op4xhrxqy1jrnvbuly-shape a sh:NodeShape ;
    rdfs:label "Business Registry Number" ;
    rdfs:comment "Cordova Business Registration Number. Format: BIZ-NNNNNN where NNNNNN is a six-digit sequence number assigned at incorporation. Required for all business filings, tax records, and port authority transactions." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue schema:identifier ;
            sh:path skos:broadMatch ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "BIZ-[0-9]{6}" ],
        [ sh:hasValue <http://schema.org/identifier> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q12047291> ;
            sh:path rdfs:isDefinedBy ] ;
    sh:targetNode sdc4:mc-l8f0m7op4xhrxqy1jrnvbuly ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-m9xg6e182m1oq77ssrf9iujv-shape a sh:NodeShape ;
    rdfs:label "activity_description" ;
    rdfs:comment "Detailed description of what this activity does and its purpose." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 2000 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path sdc4:xdstring-value ],
        [ sh:hasValue <https://www.w3.org/TR/prov-dm/> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-m9xg6e182m1oq77ssrf9iujv ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-ndvtjiq0cke0q1trw58rtrq2-shape a sh:NodeShape ;
    rdfs:label "person_given_name" ;
    rdfs:comment "Given (first) name of the person agent." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q202444> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 100 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path sdc4:xdstring-value ] ;
    sh:targetNode sdc4:mc-ndvtjiq0cke0q1trw58rtrq2 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-nj7s1gk45tfgyooxpz0qaha3-shape a sh:NodeShape ;
    rdfs:label "National ID (CID)" ;
    rdfs:comment "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q1140371> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue schema:identifier ;
            sh:path skos:broadMatch ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "COR-(AL|BR|CE)0[1-3]-[0-9]{6}" ],
        [ sh:hasValue <http://schema.org/identifier> ;
            sh:path rdfs:isDefinedBy ] ;
    sh:targetNode sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-o72s5793973fzho35rnaughs-shape a sh:NodeShape ;
    rdfs:label "activity_timestamp_start" ;
    rdfs:comment "When the provenance activity began. Maps to prov:startedAtTime. ISO 8601 format." ;
    sh:node sdc4:XdTemporalBaseShape ;
    sh:property [ sh:datatype xsd:time ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtemporal-time ],
        [ sh:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/Activity> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtemporal-datetime ] ;
    sh:targetNode sdc4:mc-o72s5793973fzho35rnaughs ;
    sdc4-meta:sdcType "XdTemporalType" .

sdc4:mc-pdykwzsug7pfncjsrry73x1s-shape a sh:NodeShape ;
    rdfs:label "contact_phone" ;
    rdfs:comment "Primary contact phone number." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.wikidata.org/wiki/Q214995> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\+?\\d[\\d\\s\\-\\(\\)]{6,18}" ] ;
    sh:targetNode sdc4:mc-pdykwzsug7pfncjsrry73x1s ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-px6j779dnapp4fjlohula4mh-shape a sh:NodeShape ;
    rdfs:label "software_service_endpoint" ;
    rdfs:comment "API endpoint or service URL if applicable." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;

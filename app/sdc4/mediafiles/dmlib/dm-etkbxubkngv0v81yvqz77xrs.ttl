    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-zcf4f5kjjo497jeb9vtt9rmr a sdc4-meta:ModelComponent ;

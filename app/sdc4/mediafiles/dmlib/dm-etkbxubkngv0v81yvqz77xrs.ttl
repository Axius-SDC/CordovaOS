        <https://www.who.int/data/data-collection-tools/civil-registration-and-vital-statistics-(crvs)> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-ll6ltsnvakomixuitxkbkxfz a sdc4-meta:ModelComponent ;
    rdfs:label "Fax Number" ;
    rdfs:comment "A facsimile telephone number, optionally starting with a plus sign and country code, with digits, spaces, hyphens and parentheses allowed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-moo2lije2b05ylq8q4t52lcb a sdc4-meta:ModelComponent ;
    rdfs:label "Date Range End" ;
    rdfs:comment "The last date of a period." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-ncxxt7wgs7soxw7kbmapxvg3 a sdc4-meta:ModelComponent ;
    rdfs:label "Address (Line 1)" ;
    rdfs:comment "The first line of a street address: street number and name, or a post office box." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-nf1air1zbj8v9w66jozdxmyl a sdc4-meta:ModelComponent ;
    rdfs:label "On Behalf Of Reference" ;
    rdfs:comment "The party on whose behalf the agent acted (FHIR agent.onBehalfOf; prov:actedOnBehalfOf). Holds the IRI of the referenced thing." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-nj7s1gk45tfgyooxpz0qaha3 a sdc4-meta:ModelComponent ;
    rdfs:label "National ID (CID)" ;
    rdfs:comment "Cordova National Identity Number. Format: COR-PPCC-NNNNNN where PP is the two-letter province code (AL=Aldara, BR=Brevina, CE=Celara), CC is the two-digit city code (01-03), and NNNNNN is a six-digit sequence number. Issued at birth or naturalization. Required for all government transactions." ;
    rdfs:isDefinedBy <http://schema.org/identifier>,
        <https://www.wikidata.org/wiki/Q1140371> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-og08xf6bu928uuz6t3y0e23f a sdc4-meta:ModelComponent ;
    rdfs:label "Acted On Behalf Of Reference" ;
    rdfs:comment "The agent on whose behalf this agent acted (prov:actedOnBehalfOf). Holds the IRI of the referenced thing." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-onj0p50oeldicgsyn89zdur8 a sdc4-meta:ModelComponent ;
    rdfs:label "Activity: activityhalted activityongoing states" ;
    rdfs:comment "States of the activityhalted activityongoing path of the Activity workflow, in order: ActivityHalted, ActivityOngoing. A transition is legal between adjacent states. An activity's lifecycle in the Data Privacy Vocabulary: proposed, planned, ongoing, halted, completed, not completed." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-oo32glasgdj6b8x4luu73875 a sdc4-meta:ModelComponent ;
    rdfs:label "Activity: Main path" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-owvuvkek3csshxqlvjlp03gk a sdc4-meta:ModelComponent ;
    rdfs:label "Cordova System Identifier" ;
    rdfs:comment "The identifier of the Cordova government system that created, committed or handled the record (PROV agent identifier; the audit's system id)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-pf1mrtzd9ld1939qanem0olk a sdc4-meta:ModelComponent ;
    rdfs:label "Civil Registry Attestation" ;
    rdfs:comment "Attestation for civil registry records (births, marriages, name changes). The civil registry office attests to record accuracy. W3C PROV-DM, GDPR/UN CEB." ;
    rdfs:isDefinedBy prov:Activity,
        <https://www.w3.org/TR/vc-data-model/#credentials>,
        <https://www.wikidata.org/wiki/Q116890704> ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Q12047392> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#AttestationType> .

sdc4:mc-piaz5w21hsuq3hpysyetuvvk a sdc4-meta:ModelComponent ;
    rdfs:label "Civil Registry Office" ;
    rdfs:comment "Government office responsible for civil registry records (births, marriages, deaths, name changes). W3C PROV-DM Agent (Organization)." ;
    rdfs:isDefinedBy <http://schema.org/GovernmentOrganization>,
        prov:Agent,
        schema:Organization,
        <https://www.wikidata.org/wiki/Q745221> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#PartyType> .

sdc4:mc-q922mqaon3yn5zlwf2bszf28 a sdc4-meta:ModelComponent ;
    rdfs:label "Email Address" ;
    rdfs:comment "An email address. The pattern requires a local part, an at sign and a domain with a dot; RFC 5321 limits the whole address to 254 characters." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-qb90a0sp9vvb6c5cbcf236ys a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Email" ;
    rdfs:comment "The agent's email address (foaf:mbox)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-qh625ukiiju3ak4x45tehcnr a sdc4-meta:ModelComponent ;
    rdfs:label "Longitude" ;
    rdfs:comment "Geographic longitude in decimal degrees, -180 to +180." ;

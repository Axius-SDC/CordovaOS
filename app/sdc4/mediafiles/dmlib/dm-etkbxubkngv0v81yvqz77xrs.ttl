sdc4:mc-w2ruemcfy35rw60jl1t9dew2 a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Identifier" ;
    rdfs:comment "The identifier of a PROV agent: a URI or another globally unique identifier." ;

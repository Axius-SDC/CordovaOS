sdc4:mc-yahxccv0l1z6ykjxayzkdlkq a sdc4-meta:ModelComponent ;
    rdfs:label "Name Prefix" ;
    rdfs:comment "An honorific or title placed before a person's name, such as Mr., Ms., Dr. or Prof." ;

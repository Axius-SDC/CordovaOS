sdc4:mc-hp420l0x5p6z0tk7nbcpsg0k a sdc4-meta:ModelComponent ;
    rdfs:label "Activity: Main path states" ;
    rdfs:comment "States of the Main path path of the Activity workflow, in order: ActivityProposed, ActivityPlanned, ActivityOngoing, ActivityCompleted. A transition is legal between adjacent states. An activity's lifecycle in the Data Privacy Vocabulary: proposed, planned, ongoing, halted, completed, not completed." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .


sdc4:mc-j0guci7y3gerygjc4hkgbgcr a sdc4-meta:ModelComponent ;
    rdfs:label "Activity: activityhalted activitynotcompleted states" ;
    rdfs:comment "States of the activityhalted activitynotcompleted path of the Activity workflow, in order: ActivityHalted, ActivityNotCompleted. A transition is legal between adjacent states. An activity's lifecycle in the Data Privacy Vocabulary: proposed, planned, ongoing, halted, completed, not completed." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-jc1lfk3ovt6l8frhxvx8b669 a sdc4-meta:ModelComponent ;
    rdfs:label "Surname (Person)" ;
    rdfs:comment "The family name of a person, shared with other members of the family. Also called last name or family name." ;

    rdfs:seeAlso <https://www.wikidata.org/wiki/Q4830453> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdFileType> .

sdc4:mc-ytw6qjtq5gilrvkfsohsrlkh a sdc4-meta:ModelComponent ;

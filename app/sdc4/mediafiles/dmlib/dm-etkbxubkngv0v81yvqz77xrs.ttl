sdc4:mc-wr06h54xqqw2q9id8i9673jy a sdc4-meta:ModelComponent ;
    rdfs:label "Activity Identifier" ;
    rdfs:comment "The identifier of a PROV activity: a URI or another globally unique identifier." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-wriny2gz8aqcvffmfpwbompk a sdc4-meta:ModelComponent ;
    rdfs:label "Website URL" ;
    rdfs:comment "The URL of a web page or online resource, such as an organization's website or a person's profile page." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdLinkType> .


sdc4:mc-etkbxubkngv0v81yvqz77xrs a schema:Dataset,
        sdc4-meta:ModelComponent ;
    rdfs:label "Civil Registry 4.4.0" ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q83708009> ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Q131721>,
        <https://www.wikidata.org/wiki/Q83708009> ;

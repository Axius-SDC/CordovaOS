    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q17197366> ;
    sdc4-meta:describesConceptualEntity sdc4:concept-organization_type ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .


sdc4:mc-jehcvvbkw36i1ecd5ooqbwp9 a sdc4-meta:ModelComponent ;
    rdfs:label "Person Gender Identity Code" ;
    rdfs:comment "A gender of a person's identity. The cultural meanings of patterns of behavior, experience, and personality that are labeled masculine or feminine. NIEM 6.0 hs:PersonGenderIdentityCode. Codes of hs:PersonGenderIdentityCodeSimpleType (9 values)." ;

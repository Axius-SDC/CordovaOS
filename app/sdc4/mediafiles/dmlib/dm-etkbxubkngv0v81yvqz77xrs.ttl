    rdfs:comment "The coordinate reference system of a latitude and longitude pair, by EPSG code. WGS 84 (EPSG:4326) is what GPS and most web maps use." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-kv5qqs3o4jwcwz9javgw1pzh a skos:ConceptScheme,
        sdc4-meta:ModelComponent ;
    rdfs:label "Province" ;
    rdfs:comment "One of the three provinces of the Republic of Cordova. Used across civil registry, property, tax, and all geographic records." ;
    rdfs:isDefinedBy <http://schema.org/AdministrativeArea>,
        schema:State ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .


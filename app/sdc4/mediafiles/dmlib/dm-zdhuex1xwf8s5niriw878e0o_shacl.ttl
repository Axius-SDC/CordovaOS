sdc4:mc-uyck6fsutdjj7i7tb0olkq2f-shape a sh:NodeShape ;
    rdfs:label "Act Lifecycle: completed nullified states" ;
    rdfs:comment "States of the completed nullified path of the Act Lifecycle workflow, in order: completed, nullified. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/act-lifecycle-completed-nullified-states> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:in ( "completed" "nullified" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://terminology.hl7.org/CodeSystem/v3-ActStatus> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-uyck6fsutdjj7i7tb0olkq2f ;
    sdc4-meta:sdcType "XdOrdinalType" .


sdc4:mc-kyo26nubrheaptga70njjzjd-shape a sh:NodeShape ;
    rdfs:label "Act Lifecycle: suspended active states" ;
    rdfs:comment "States of the suspended active path of the Act Lifecycle workflow, in order: suspended, active. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue <http://terminology.hl7.org/CodeSystem/v3-ActStatus> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:in ( "suspended" "active" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/act-lifecycle-suspended-active-states> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ] ;
    sh:targetNode sdc4:mc-kyo26nubrheaptga70njjzjd ;
    sdc4-meta:sdcType "XdOrdinalType" .


            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://axius-sdc.com/library/niem/j-organization-category-nd-ex-code> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/justice.xsd> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/codes/ndex/6.0/OrganizationCategoryCodeSimpleType> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/domains/justice/6.0/OrganizationCategoryNDExCode> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-wj2nhg5v1hl2d3wa7uo3myz8 ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-wl6j4ekcmu4hvt2m12zw4zp8-shape a sh:NodeShape ;
    rdfs:label "Activity Status" ;
    rdfs:comment "The state of an activity, from the Data Privacy Vocabulary activity status concepts." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue sdc4:mc-yehcpzf43j0b5zp9ck59t9eg ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://w3id.org/dpv#ActivityStatus> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:token ;
            sh:in ( "ActivityProposed" "ActivityPlanned" "ActivityOngoing" "ActivityHalted" "ActivityCompleted" "ActivityNotCompleted" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/activity-status> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-wl6j4ekcmu4hvt2m12zw4zp8 ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-wo4j54nc8bwwvc1lcj3zu9r7-shape a sh:NodeShape ;
    rdfs:label "Verdict Issuing Judge Indicator" ;
    rdfs:comment "True if a verdict was issued by a judge or a jury; false otherwise. NIEM 6.0 j:VerdictIssuingJudgeIndicator." ;
    sh:node sdc4:XdBooleanBaseShape ;
    sh:property [ sh:datatype xsd:string ;

sdc4:mc-g38yyz970m3xhnbyjw6dtb1p-shape a sh:NodeShape ;
    rdfs:label "Act Lifecycle: suspended aborted states" ;
    rdfs:comment "States of the suspended aborted path of the Act Lifecycle workflow, in order: suspended, aborted. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/act-lifecycle-suspended-aborted-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://terminology.hl7.org/CodeSystem/v3-ActStatus> ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:string ;
            sh:in ( "suspended" "aborted" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-g38yyz970m3xhnbyjw6dtb1p ;
    sdc4-meta:sdcType "XdOrdinalType" .


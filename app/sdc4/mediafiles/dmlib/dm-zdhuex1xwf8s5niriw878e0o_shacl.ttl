        [ sh:datatype xsd:string ;
            sh:in ( "held" "nullified" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ] ;
    sh:targetNode sdc4:mc-z76d29pfazsvjaj2iwf8i5hf ;
    sdc4-meta:sdcType "XdOrdinalType" .


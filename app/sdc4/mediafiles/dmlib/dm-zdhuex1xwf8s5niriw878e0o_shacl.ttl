        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/justice.xsd> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sdc4:compression-type ],
        [ sh:hasValue <https://axius-sdc.com/library/niem/j-evidence-documentation-binary> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:base64Binary ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:media-content ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sdc4:hash-result ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sdc4:media-type ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sdc4:size ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sdc4:alt-txt ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/domains/justice/6.0/EvidenceDocumentationBinary> ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:language ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdfile-language ] ;
    sh:targetNode sdc4:mc-cqharj73hcqlltgqwunn6brc ;

            sh:path skos:exactMatch ],
        [ sh:datatype xsd:token ;
            sh:in ( "ABANDONED_AUTO" "ABDUCTION-KIDNAPPING" "ACCIDENT_CONDITIONS_UNKNOWN" "ACCIDENT_HIT_AND_RUN_INJURY" "ACCIDENT_HIT_AND_RUN_PROPERTY" "ACCIDENT_PERSONAL_INJURY" "ACCIDENT_PROPERTY_DAMAGE" "AGRESSIVE_DRIVER" "ALARM" "ANIMAL_COMPLAINT" "ARSON" "ASSAULT_AGGRAVATED" "ASSAULT_SIMPLE" "ASSIST_CITIZEN" "ASSIST_FIRE-MEDICS" "ASSIST_OUTSIDE_AGENCY" "BAD_CHECK-FORGERY" "BOLO" "BOMB_THREAT" "BOOT_REMOVAL" "BURGLARY" "CARJACKING" "CITY_PROPERTY_DAMAGE" "CREDIT_CARD_FRAUD" "DESTRUCTION" "DISABLED_MOTORIST" "DISORDERLY_CONDUCT" "DOMESTIC_VIOLENCE" "DRUG_COMPLAINT" "DRUNK_DRIVER" "E911_911_HANG_UP" "EMBEZZLEMENT" "ESCORT" "FALSE_PRETENSE-SWINDLE-CONFIDENCE" "FIGHT" "GAMBLING" "GRAND_LARCENY_AUTO" "GRAND_LARCENY_AUTO_RECOVERY" "HAZARD" "HOMICIDE" "HOSTAGE-BARRICADE_SITUATION" "IDENTITY_FRAUD" "IMPERSONATING_POLICE_OFFICER" "INTELLIGENCE_ACTIVITY" "INTOXICATED_SUBJECT" "LARCENY" "LOCKOUT" "LOUD_PARTY" "MISSING_PERSON" "NOISE_VIOLATION" "PARKING_COMPLAINT" "POLICE_INFORMATION" "PROPERTY_FOUND" "PROPERTY_LOST" "PROSTITUTION" "PROTECTIVE_ORDER_ISSUED" "PROWLER-PEEPING_TOM" "PUBLIC_SERVICE" "ROBBERY" "RUNAWAY" "SEXUAL_OFFENSE" "SHOPLIFTING" "STALKING" "SUBJECT_STOP" "SUICIDE" "SUSPICIOUS_EVENT" "SUSPICIOUS_PACKAGE-SUBSTANCE" "TELEPHONE_COMPLAINT" "TEST_CALL" "TRAFFIC_COMPLAINT" "TRAFFIC_STOP" "TRESPASSING" "TROUBLE_UNKNOWN" "TROUBLE_UNKNOWN-OFFICER_NEEDS_ASSISTANCE" "WARRANT_ISSUED" "WARRANT_SERVICE" "WEAPON_VIOLATION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],

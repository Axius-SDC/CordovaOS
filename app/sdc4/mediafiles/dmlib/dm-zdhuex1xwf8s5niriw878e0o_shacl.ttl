            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:in ( "true" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/domains/justice/6.0/ArrestCommunitySupervisionIndicator> ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:string ;
            sh:in ( "false" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:false-value ],
        [ sh:hasValue <https://axius-sdc.com/library/niem/j-arrest-community-supervision-indicator> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-wp2p68ravvj5gratjxv53k8r ;
    sdc4-meta:sdcType "XdBooleanType" .


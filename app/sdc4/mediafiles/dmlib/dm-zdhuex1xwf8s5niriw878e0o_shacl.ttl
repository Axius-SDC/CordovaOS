            sh:path sdc4:true-value ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/justice.xsd> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;

            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:string ;
            sh:in ( "true" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ],
        [ sh:hasValue <https://axius-sdc.com/library/niem/j-verdict-issuing-judge-indicator> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/domains/justice/6.0/VerdictIssuingJudgeIndicator> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-wo4j54nc8bwwvc1lcj3zu9r7 ;

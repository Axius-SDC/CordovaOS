sdc4:mc-bkuhivi6ot6nxll6vam7yobp-shape a sh:NodeShape ;
    rdfs:label "Law Enforcement Access Control" ;
    rdfs:comment "Access control policy for law enforcement data using W3C Data Privacy Vocabulary. Enforces role-based access for law enforcement officers, judicial authorities, and defense counsel. Governs dpv:CriminalOffenceData including incident reports, arrest records, and case files." ;
    sh:node sdc4:XdLinkBaseShape ;
    sh:property [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation-uri ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:link ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q185799> ;
            sh:path skos:broadMatch ],
        [ sh:hasValue <https://w3id.org/dpv#CriminalOffenceData> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:relation ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q6014597> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-bkuhivi6ot6nxll6vam7yobp ;
    sdc4-meta:sdcType "XdLinkType" .


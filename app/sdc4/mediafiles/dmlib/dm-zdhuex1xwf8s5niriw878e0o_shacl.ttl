sdc4:mc-niwbptlcq66sqjhjqtdle4dk-shape a sh:NodeShape ;
    rdfs:label "Service Call Category Code" ;
    rdfs:comment "A kind of service call as determined at the time of call receipt. NIEM 6.0 j:ServiceCallCategoryCode. Codes of ndex:CADCallCodeSimpleType (77 values)." ;

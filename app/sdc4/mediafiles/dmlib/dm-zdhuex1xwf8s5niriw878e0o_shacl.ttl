        [ sh:hasValue <https://axius-sdc.com/library/niem/j-incident-traffic-accident-involved-indicator> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/justice.xsd> ;
            sh:path dcterms:source ],
        [ sh:hasValue sdc4:mc-lr0uobalchgtucjdu68gxt8o ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:string ;
            sh:in ( "true" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ] ;
    sh:targetNode sdc4:mc-llps3bgkou8fij8j6hck2hz2 ;
    sdc4-meta:sdcType "XdBooleanType" .


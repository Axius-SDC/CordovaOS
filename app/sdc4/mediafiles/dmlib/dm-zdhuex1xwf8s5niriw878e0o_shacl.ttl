sdc4:mc-wp2p68ravvj5gratjxv53k8r-shape a sh:NodeShape ;
    rdfs:label "Arrest Community Supervision Indicator" ;
    rdfs:comment "True if a person was under some kind of community criminal justice supervision, e.g., probation, parole, pre-trial services, day reporting, at the time of the arrest; false otherwise. NIEM 6.0 j:ArrestCommunitySupervisionIndicator." ;
    sh:node sdc4:XdBooleanBaseShape ;

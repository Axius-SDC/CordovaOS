sdc4:mc-cq8pgejgs9ifxts49bna36gb-shape a sh:NodeShape ;
    rdfs:label "Custody Transfer Releasing Enforcement Official Reference" ;
    rdfs:comment "A peace official that releases custody of a subject or property. NIEM 6.0 j:CustodyTransferReleasingEnforcementOfficial. Holds the IRI of the referenced Enforcement Official record." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],

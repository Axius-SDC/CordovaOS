        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/act-lifecycle-held-nullified-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://terminology.hl7.org/> ;

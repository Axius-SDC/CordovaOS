sdc4:mc-c9zyglrzu0wmk64wdy8nc6l6-shape a sh:NodeShape ;
    rdfs:label "Act Lifecycle: new nullified states" ;
    rdfs:comment "States of the new nullified path of the Act Lifecycle workflow, in order: new, nullified. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <http://terminology.hl7.org/CodeSystem/v3-ActStatus> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:string ;
            sh:in ( "new" "nullified" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/act-lifecycle-new-nullified-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-c9zyglrzu0wmk64wdy8nc6l6 ;
    sdc4-meta:sdcType "XdOrdinalType" .


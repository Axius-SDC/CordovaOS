sdc4:mc-wj13ubhx0qd93k1oxy2zkfah-shape a sh:NodeShape ;
    rdfs:label "Enforcement Official Activity Category Code" ;
    rdfs:comment "A kind of activity or circumstance in which an enforcement official was engaged. NIEM 6.0 j:EnforcementOfficialActivityCategoryCode. Codes of ucr:LEOKAActivityCategoryCodeSimpleType (11 values)." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:token ;
            sh:in ( "ALL_OTHER" "AMBUSH-NO_WARNING" "ATTEMPTING_OTHER_ARRESTS" "BURGLARIES_IN_PROGRESS-PURSUING_BURGLARY_SUSPECTS" "CIVIL_DISORDER" "HANDLING_PERSONS_WITH_MENTAL_ILLNESS" "HANDLING-TRANSPORTING-CUSTODY_OF_PRISONERS" "INVESTIGATING_SUSPICIOUS_PERSONS-CIRCUMSTANCES" "RESPONDING_TO_DISTURBANCE_CALL" "ROBBERIES_IN_PROGRESS-PURSUING_ROBBERY_SUSPECTS" "TRAFFIC_PURSUITS-STOPS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://axius-sdc.com/library/niem/j-enforcement-official-activity-category-code> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/codes/ucr/6.0/LEOKAActivityCategoryCodeSimpleType> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/domains/justice/6.0/EnforcementOfficialActivityCategoryCode> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/justice.xsd> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-wj13ubhx0qd93k1oxy2zkfah ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-wj2nhg5v1hl2d3wa7uo3myz8-shape a sh:NodeShape ;

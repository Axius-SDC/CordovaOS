            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\S+" ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/justice.xsd> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/domains/justice/6.0/CustodyTransferReleasingEnforcementOfficial> ;
            sh:path skos:exactMatch ],

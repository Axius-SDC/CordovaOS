        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/niem-core.xsd> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 4000 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-ces753kz92cp4zdyva7qw530 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-cgj2hcgmjcvq96n5oumm2axv-shape a sh:NodeShape ;
    rdfs:label "Plea No Contest Indicator" ;
    rdfs:comment "True if a person is willing to accept the consequences of a charge without admitting guilt or innocence; false otherwise. NIEM 6.0 j:PleaNoContestIndicator." ;
    sh:node sdc4:XdBooleanBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com/library/niem/j-plea-no-contest-indicator> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:in ( "false" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:false-value ],
        [ sh:datatype xsd:string ;
            sh:in ( "true" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:true-value ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/ns/model/domains/justice/6.0/PleaNoContestIndicator> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://docs.oasis-open.org/niemopen/niem-model/v6.0/ps02/xsd/domains/justice.xsd> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-cgj2hcgmjcvq96n5oumm2axv ;
    sdc4-meta:sdcType "XdBooleanType" .


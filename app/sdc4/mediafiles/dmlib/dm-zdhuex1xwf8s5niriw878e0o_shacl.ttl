sdc4:mc-sdxzxke44myw361ozn1n71y3-shape a sh:NodeShape ;
    rdfs:label "Act Lifecycle: new held states" ;
    rdfs:comment "States of the new held path of the Act Lifecycle workflow, in order: new, held. A transition is legal between adjacent states. The lifecycle of an act in the HL7 v3 Reference Information Model: preparatory (new, held), active, suspended, and the terminal states completed, cancelled, aborted, with nullified and obsolete outside the normal course. The generic clinical and administrative act state machine." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:datatype xsd:string ;
            sh:in ( "new" "held" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <http://terminology.hl7.org/CodeSystem/v3-ActStatus> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/act-lifecycle-new-held-states> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-sdxzxke44myw361ozn1n71y3 ;
    sdc4-meta:sdcType "XdOrdinalType" .


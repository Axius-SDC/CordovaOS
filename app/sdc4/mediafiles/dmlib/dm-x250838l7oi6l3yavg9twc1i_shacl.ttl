sdc4:mc-nesxtz8c5o665swc9lhvqkjj-shape a sh:NodeShape ;
    rdfs:label "PROV Agent Type" ;
    rdfs:comment "Classification of agents responsible for activities and entities in W3C PROV-DM. Agents bear responsibility for activities and entity generation." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue prov:Agent ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:token ;
            sh:in ( "Person" "Organization" "SoftwareAgent" ) ;
            sh:maxCount 1 ;

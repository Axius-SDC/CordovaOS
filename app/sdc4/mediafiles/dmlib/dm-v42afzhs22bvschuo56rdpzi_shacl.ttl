    sh:property [ sh:hasValue schema:givenName ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://www.wikidata.org/entity/Q202444> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 100 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path sdc4:xdstring-value ],
        [ sh:hasValue <https://axius-sdc.com/library/default/given-name-person> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue schema: ;
            sh:path dcterms:source ],
        [ sh:hasValue sdc4:mc-kfyzf8u8gdafcpt5kfh2qg3q ;
            sh:path prov:wasRevisionOf ] ;
    sh:targetNode sdc4:mc-l9l169co9r23e6fftpvdz4e3 ;
    sdc4-meta:sdcType "XdStringType" .


sdc4:mc-lntxobl1hblm5iutviwnle1x-shape a sh:NodeShape ;
    rdfs:label "Reservation: reservationpending reservationcancelled states" ;
    rdfs:comment "States of the reservationpending reservationcancelled path of the Reservation workflow, in order: ReservationPending, ReservationCancelled. A transition is legal between adjacent states. A reservation's status per schema.org ReservationStatusType: pending, on hold, confirmed, cancelled." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue schema:ReservationStatusType ;
            sh:path skos:exactMatch ],
        [ sh:hasValue schema: ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:string ;
            sh:in ( "ReservationPending" "ReservationCancelled" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/reservation-reservationpending-reservationcancelled-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-lntxobl1hblm5iutviwnle1x ;
    sdc4-meta:sdcType "XdOrdinalType" .


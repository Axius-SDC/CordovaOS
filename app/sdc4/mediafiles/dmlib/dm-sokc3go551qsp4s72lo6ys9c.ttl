sdc4:mc-v50gp8o31f1u0p5evnjgezbk a sdc4-meta:ModelComponent ;
    rdfs:label "Person Sur Name Prefix" ;
    rdfs:comment "A prefix that precedes this person's family name such as Van, Von. NIEM 6.0 nc:PersonSurNamePrefixText." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-vh5jbumsfax6iw9vez68om83 a sdc4-meta:ModelComponent ;
    rdfs:label "Vital Record Attestation" ;
    rdfs:comment "Attestation for vital record events (births, deaths, marriages, divorces). Linked to the registrar or certifying authority via Party. Standards: W3C PROV-DM, GDPR/UN CEB." ;
    rdfs:isDefinedBy prov:Activity,
        <https://www.w3.org/TR/vc-data-model/#credentials>,
        <https://www.wikidata.org/wiki/Q116890704> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#AttestationType> .

sdc4:mc-vhezo2cckpe92x4c3j2memeh a sdc4-meta:ModelComponent ;
    rdfs:label "Had Plan Reference" ;
    rdfs:comment "The plan the activity followed (prov:hadPlan). Holds the IRI of the referenced thing." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-vmikfu0irht9fmq7q02t3oqs a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Activity" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-vo9jtmexkaaol3y657fm0xn8 a sdc4-meta:ModelComponent ;
    rdfs:label "Registration Date" ;
    rdfs:comment "Date the business was officially registered in Cordova" ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q137375576> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-w2ruemcfy35rw60jl1t9dew2 a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Identifier" ;
    rdfs:comment "The identifier of a PROV agent: a URI or another globally unique identifier." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-wn5su07s9sgs1dhuuomiza68 a sdc4-meta:ModelComponent ;
    rdfs:label "Vital Record Attestation Reason" ;

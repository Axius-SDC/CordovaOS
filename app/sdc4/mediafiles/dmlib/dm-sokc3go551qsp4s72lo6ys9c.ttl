    rdfs:isDefinedBy <http://release.niem.gov/niem/niem-core/5.0/niem-core.owl#NotaryPublicIdentificationID> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ytnivgvva7e7tadwsljrlvqf a sdc4-meta:ModelComponent ;

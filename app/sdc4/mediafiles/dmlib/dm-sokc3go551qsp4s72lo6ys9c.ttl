    rdfs:seeAlso <https://www.wikidata.org/wiki/Q484652> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-wr06h54xqqw2q9id8i9673jy a sdc4-meta:ModelComponent ;
    rdfs:label "Activity Identifier" ;
    rdfs:comment "The identifier of a PROV activity: a URI or another globally unique identifier." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-wumhbfo7ckp3f0n0vsjzhq3q a sdc4-meta:ModelComponent ;
    rdfs:label "Effective Date" ;
    rdfs:comment "A date that information take effect. NIEM 6.0 nc:EffectiveDate." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-x0lebwtobgaelj5pev3258sd a sdc4-meta:ModelComponent ;
    rdfs:label "Software Version" ;
    rdfs:comment "The version of a software agent." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-xcyx87fkkzxam65vglkbd384 a sdc4-meta:ModelComponent ;
    rdfs:label "Cordova System Audit" ;
    rdfs:comment "The audit of a Cordova government record: the system that handled it, the system user, and where (Default geolocation, Cordova city and province). Replaces the June ProvGov System Audit in every Cordova model." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#AuditType> .

sdc4:mc-xlgjqdpwdbn2re3mdh5yy2rk a sdc4-meta:ModelComponent ;
    rdfs:label "Error Message" ;
    rdfs:comment "The error the activity reported, if it failed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-xs3gdcg5cfkqxj0ckihp48j8 a sdc4-meta:ModelComponent ;
    rdfs:label "Document Publishing: published retracted from publication states" ;
    rdfs:comment "States of the published retracted from publication path of the Document Publishing workflow, in order: published, retracted-from-publication. A transition is legal between adjacent states. The publishing lifecycle of a document from the SPAR Publishing Status Ontology: draft, submission, review, acceptance or rejection, proof, publication, version of record, archive, with withdrawal, revision, embargo and retraction." ;
    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-xxe21o9ojzmy9wxxky1tnmog a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Name" ;
    rdfs:comment "The name of the agent (foaf:name)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-yahxccv0l1z6ykjxayzkdlkq a sdc4-meta:ModelComponent ;
    rdfs:label "Name Prefix" ;
    rdfs:comment "An honorific or title placed before a person's name, such as Mr., Ms., Dr. or Prof." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ycujkecjszwwrcd6dhxesk73 a sdc4-meta:ModelComponent ;

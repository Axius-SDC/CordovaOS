<sdc4:mc-fdwlhbher1gm91zfmf8mno6c> a <sdc4-meta:ModelComponent> ;
    rdfs:label "Civil Registry Access Control" ;
    rdfs:comment "Access control policy for civil registration data using W3C Data Privacy Vocabulary. Enforces role-based access for registry officials, citizens, and legal representatives. Governs dpv:IdentifyingPersonalData including birth, marriage, and death records." ;
    rdfs:isDefinedBy <https://w3id.org/dpv#AccessControlMethod>,
        <https://www.wikidata.org/wiki/Q83708009> ;
    rdfs:seeAlso <https://w3id.org/dpv>,
        <https://w3id.org/dpv#IdentifyingPersonalData> ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-civil_registry_access_control> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:XdLinkType> .


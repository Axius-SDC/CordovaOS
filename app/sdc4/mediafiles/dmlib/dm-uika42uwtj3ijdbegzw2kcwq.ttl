        <sdc4-meta:ModelComponent> ;
    rdfs:label "Relationship Type" ;
    rdfs:comment "Familial or legal relationship between two persons in the Cordova Civil Registry." ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q69901743> ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-relationship_type> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:XdTokenType> .

<sdc4:mc-bgjt4mvgvkxcn6hurg37u21b> a <sdc4-meta:ModelComponent> ;

<dm-uika42uwtj3ijdbegzw2kcwq> dc:coverage "Universal" ;
    dc:creator "Timothy Cook" ;
    dc:date "2026-07-29 13:10:43.173521+00:00" ;
    dc:description "Maintain the authoritative identity record for every person in Cordova." ;
    dc:format "text/xml" ;
    dc:identifier "dm-uika42uwtj3ijdbegzw2kcwq" ;
    dc:language "en-US" ;
    dc:publisher "Axius SDC, Inc." ;
    dc:relation "None" ;
    dc:rights "CC-BY http://creativecommons.org/licenses/by/3.0/" ;
    dc:subject "Civil Registry" ;
    dc:title "Civil Registry" ;
    dc:type "SDC Data Model (DM)" .

<sdc4:mc-a127ihw8xbfbl24lbcvnspv0> a schema:Text,
        <sdc4-meta:ModelComponent> ;
    rdfs:label "contact_name" ;
    rdfs:comment "Contact name for the service." ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-contact_name> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:XdStringType> .

<sdc4:mc-a6zjaj7dunnwxdtc2skdpepx> a <sdc4-meta:ModelComponent> ;
    rdfs:label "Civil Registry Attestation Reason" ;
    rdfs:comment "Reason for attesting this civil registry record" ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q132364> ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Q4830453> ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-civil_registry_attestation_reason> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:XdStringType> .

<sdc4:mc-aan7382wp8e2f58m9a2hvmkp> a <sdc4-meta:ModelComponent> ;
    rdfs:label "Civil Registry Governed Record" ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:ClusterType> .

<sdc4:mc-atdtdfzruh7tya0iv5cz365l> a skos:ConceptScheme,
        <sdc4-meta:ModelComponent> ;
    rdfs:label "City" ;
    rdfs:comment "One of the nine cities in the Republic of Cordova." ;
    rdfs:isDefinedBy <http://schema.org/City> ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-city> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:XdTokenType> .

<sdc4:mc-avqpyqft9tm22yyink3ltcty> a <sdc4-meta:ModelComponent> ;
    rdfs:label "Related Person" ;
    rdfs:comment "Person related to the civil registry subject via family relationship (parent, child, spouse, etc.). W3C PROV-DM Agent (Person) with Cordova CID." ;
    rdfs:isDefinedBy prov:Agent,
        schema:Person,
        <https://www.wikidata.org/wiki/Q22988604> ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-related_person> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:PartyType> .

<sdc4:mc-azmp0vkmkmtne1goba54qubu> a <sdc4-meta:ModelComponent> ;
    rdfs:label "Civil Registration Protocol" ;
    rdfs:comment "Protocol reference for the Civil Registry data model. Informed by the United Nations Guidelines on Civil Registration and Vital Statistics Systems, the Handbook on Civil Registration and Vital Statistics (UN Statistics Division), and regional civil code frameworks." ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q132364> ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Q69484> ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-civil_registration_protocol> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:XdStringType> .

<sdc4:mc-bd3s8t23d6m3zizmpwavc32y> a <sdc4-meta:ModelComponent> ;
    rdfs:label "system_identifier" ;
    rdfs:comment "Identifier of the system that handled the data. Maps to prov:Entity context in the PROV-O export. This is the AuditType.system-id field." ;
    rdfs:isDefinedBy <https://www.wikidata.org/wiki/Q7663715> ;
    sdc4-meta:describesConceptualEntity <sdc4:concept-system_identifier> ;
    sdc4-meta:isConstrainedByRmComponent <sdc4:XdStringType> .


            sh:path sdc4:link ],
        [ sh:hasValue <https://www.wikidata.org/wiki/Q6014597> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:hasValue <https://w3id.org/dpv#AccessControlMethod> ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;

sdc4:mc-iljgw5s1pgrmc2c71k5bg62z-shape a sh:NodeShape ;
    rdfs:label "Payment: Main path states" ;
    rdfs:comment "States of the Main path path of the Payment workflow, in order: PaymentDue, PaymentComplete. A transition is legal between adjacent states. A payment's status per schema.org PaymentStatusType: due, past due, complete, declined, automatically applied." ;

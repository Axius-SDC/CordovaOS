sdc4:mc-fqypuxcmtrc2n2qdanyorp4t-shape a sh:NodeShape ;
    rdfs:label "Payment: paymentpastdue paymentdeclined states" ;
    rdfs:comment "States of the paymentpastdue paymentdeclined path of the Payment workflow, in order: PaymentPastDue, PaymentDeclined. A transition is legal between adjacent states. A payment's status per schema.org PaymentStatusType: due, past due, complete, declined, automatically applied." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue schema: ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue schema:PaymentStatusType ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:string ;
            sh:in ( "PaymentPastDue" "PaymentDeclined" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/payment-paymentpastdue-paymentdeclined-states> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-fqypuxcmtrc2n2qdanyorp4t ;
    sdc4-meta:sdcType "XdOrdinalType" .


    sh:property [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue schema: ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:in ( "PaymentDue" "PaymentComplete" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/payment-main-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue schema:PaymentStatusType ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-iljgw5s1pgrmc2c71k5bg62z ;
    sdc4-meta:sdcType "XdOrdinalType" .

